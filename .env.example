# ---------------------------------------------------------------------------
# Suskii Travels environment variables.
# Copy to `.env` (never commit it):   PowerShell: Copy-Item .env.example .env
#                                     bash/zsh:   cp .env.example .env
# Leave secrets empty until real credentials exist; mock adapters are used
# while a provider key is blank. Production secrets live in the cloud secret
# manager and are injected at runtime, never baked into images or app bundles.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
WORKER_HEALTH_PORT=4100

# --- Local infrastructure (docker-compose.yml) --------------------------------
# Local-only defaults; ports are bound to 127.0.0.1.
POSTGRES_USER=suskii
POSTGRES_PASSWORD=suskii_local_dev
POSTGRES_DB=suskii
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://suskii:suskii_local_dev@localhost:5432/suskii?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth and encryption -----------------------------------------------------
# Asymmetric JWT signing keys (format decided in phase 2).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Cloud KMS key used for envelope encryption of passport numbers and visa documents.
ENCRYPTION_KMS_KEY_ID=

# --- Suppliers ---------------------------------------------------------------
DUFFEL_API_TOKEN=
HOTEL_PROVIDER_API_KEY=
HOTEL_PROVIDER_SECRET=

# --- Payments (test-mode keys only outside production) -----------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- FX, messaging ----------------------------------------------------------
FX_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# --- Object storage ----------------------------------------------------------
S3_BUCKET=
S3_REGION=

# --- Bot protection (Cloudflare Turnstile) -----------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Observability and analytics ---------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=

# --- Client-side API base URLs (public, bundled into web/mobile) ------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Optional AI trip search (phase 13) --------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
