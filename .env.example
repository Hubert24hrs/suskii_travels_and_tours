# ---------------------------------------------------------------------------
# Suskii Travels environment variables.
# Copy to `.env` (never commit it):   PowerShell: Copy-Item .env.example .env
#                                     bash/zsh:   cp .env.example .env
# Leave secrets empty until real credentials exist; mock adapters are used
# while a provider key is blank. Production secrets live in the cloud secret
# manager and are injected at runtime, never baked into images or app bundles.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
WORKER_HEALTH_PORT=4100

# --- Local infrastructure (docker-compose.yml) --------------------------------
# Local-only defaults; ports are bound to 127.0.0.1.
POSTGRES_USER=suskii
POSTGRES_PASSWORD=suskii_local_dev
POSTGRES_DB=suskii
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://suskii:suskii_local_dev@localhost:5432/suskii
REDIS_URL=redis://localhost:6379
# Production requires TLS: `?sslmode=verify-full` on DATABASE_URL and `rediss://` for Redis (the
# worker also needs an https API_INTERNAL_URL). Set an *_ALLOW_PLAINTEXT flag only when that hop is
# private and encrypted another way (Unix socket, local Cloud SQL Auth Proxy, mesh mTLS; ADR-038).
DATABASE_ALLOW_PLAINTEXT=false
REDIS_ALLOW_PLAINTEXT=false

# --- HTTP --------------------------------------------------------------------
# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Used in email links (verify email, reset password).
WEB_APP_URL=http://localhost:3000
# Reverse proxies (load balancer, Cloudflare) in front of the API; 0 locally.
TRUST_PROXY_HOPS=0

# --- Auth and encryption -----------------------------------------------------
# Generate every secret below with:  pnpm --filter @suskii/api keys:generate
# Blank values in development and tests use per-process ephemeral keys (sessions and MFA
# enrolments then stop working after a restart). Production refuses to start without them.
# Ed25519 access-token signing keys: PEM or base64 of the PEM.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Retired public keys still accepted during a key rotation (`|`-separated).
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Signed-in devices per account; a new sign-in beyond the cap ends the least recently used one.
MAX_ACTIVE_SESSIONS=10
# Staff accounts (ADR-037): device cap, idle timeout and absolute session lifetime.
STAFF_MAX_ACTIVE_SESSIONS=3
STAFF_SESSION_IDLE_MINUTES=30
STAFF_SESSION_MAX_HOURS=12
# Minutes an authenticator code counts for step-up admin actions (roles, refunds, pricing).
STEP_UP_WINDOW_MINUTES=10
# AES-256-GCM key for field-level encryption (32 bytes, base64) until the KMS adapter lands.
FIELD_ENCRYPTION_KEY=
# Key id written into new envelopes. To rotate (ADR-038, docs/runbooks/key-rotation.md): new key
# and id here, the old pair as `id:base64key` in FIELD_ENCRYPTION_PREVIOUS_KEYS, deploy, then run
# `pnpm --filter @suskii/api keys:reencrypt --yes` and drop the old pair once nothing is left.
FIELD_ENCRYPTION_KEY_ID=k1
FIELD_ENCRYPTION_PREVIOUS_KEYS=
# Master secret (>= 32 chars) for HMAC subkeys: IP hashing, CSRF tokens, OTP hashes.
HMAC_SECRET=
# Cloud KMS key used for envelope encryption of passport numbers and visa documents (phase 12).
ENCRYPTION_KMS_KEY_ID=
# Cookie attributes for the web transport. Local plain-HTTP development only: COOKIE_SECURE=false
# drops the __Secure- prefix. Production requires true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Social sign-in: OAuth client IDs (comma-separated). A provider stays disabled while blank.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Breached-password check (HIBP range API, k-anonymity).
HIBP_ENABLED=true
# Optional exact-IP allowlist for /v1/admin routes (comma-separated).
ADMIN_IP_ALLOWLIST=
# Admin console origins (ADR-033): cookie-authenticated admin requests must come from one of them.
# Each must also be in CORS_ORIGINS; https only in production.
ADMIN_ORIGINS=http://localhost:3001
RATE_LIMIT_ENABLED=true
# Local seed only (never production): creates a super admin; enrol MFA before using admin routes.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Suppliers and search -----------------------------------------------------
# Enabled suppliers (feature flags). `mock` returns synthetic, clearly labelled offers and is
# refused in production unless ALLOW_MOCK_PROVIDERS=true. `duffel` needs DUFFEL_API_TOKEN.
FLIGHT_SUPPLIERS=mock
HOTEL_SUPPLIERS=mock
DUFFEL_API_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
HOTEL_PROVIDER_API_KEY=
HOTEL_PROVIDER_SECRET=
# Whole-search budget and per-supplier timeout (ms); identical searches are cached (seconds).
SEARCH_TIMEOUT_MS=12000
SUPPLIER_TIMEOUT_MS=10000
SEARCH_CACHE_TTL_SECONDS=600
# Booking (ticketing) calls to a supplier get longer than searches (ms).
SUPPLIER_BOOKING_TIMEOUT_MS=45000
# Mock flight supplier only: routes whose price changes at the re-price right before payment, in
# basis points (ORIGIN-DESTINATION:bps, comma-separated), to walk through price-change consent.
MOCK_REPRICE_RULES=

# --- Deals, hotel destinations and the worker (ADR-011) -----------------------
# Service token for /v1/internal routes, shared by the API and the worker. The value below is for
# local development only and is refused in production; generate a real one with keys:generate.
INTERNAL_API_TOKEN=local-dev-only-internal-token-change-me
# Worker -> API base URL (server to server).
API_INTERNAL_URL=http://localhost:4000
API_INTERNAL_ALLOW_PLAINTEXT=false
# Deals and destination prices older than this are hidden; snapshots are kept for price history.
DEALS_MAX_AGE_HOURS=24
DEALS_DEPARTURE_OFFSETS_DAYS=21,45
DESTINATIONS_CHECK_IN_OFFSET_DAYS=30
SNAPSHOT_RETENTION_DAYS=7
# Worker schedules (minutes).
DEALS_REFRESH_INTERVAL_MINUTES=180
DESTINATIONS_REFRESH_INTERVAL_MINUTES=360
# Visa documents: rescan lost background scans (seconds), delete past retention (hours), ADR-026.
VISA_SCAN_INTERVAL_SECONDS=300
VISA_PRUNE_INTERVAL_HOURS=24
# Account sweeps (minutes): due price alerts, check-in and Prime reminders, referrals.
PRICE_ALERT_SWEEP_MINUTES=15
REMINDER_SWEEP_MINUTES=15
REFERRAL_SWEEP_MINUTES=60
# Daily sweep of records past their retention period (ADR-039).
RETENTION_SWEEP_INTERVAL_HOURS=24

# --- Payments (test-mode keys only outside production) -----------------------
# Hosted-checkout providers in preference order (ADR-016): mock, paystack, flutterwave, stripe.
# The checkout offers those that settle the booking currency. `mock` (checkout page on the web
# app) is refused in production unless ALLOW_MOCK_PROVIDERS=true. Each real provider needs its
# keys below; register the webhook URL /v1/payments/webhooks/<provider> with the provider.
PAYMENT_PROVIDERS=mock
PAYMENT_SESSION_TTL_MINUTES=30
PAYMENT_PROVIDER_TIMEOUT_MS=15000
# Pending payments older than this are verified with the provider (lost webhooks).
PAYMENT_RECONCILE_AFTER_MINUTES=15
# Holds and installments (ADR-018). Fees and the default policy are owner decisions; 0 = none.
HOLD_MIN_WINDOW_HOURS=6
HOLD_SAFETY_MARGIN_MINUTES=120
HOLD_MAX_ACTIVE=2
INSTALLMENT_DEPOSIT_BPS=3000
INSTALLMENT_MAX_COUNT=3
INSTALLMENT_MIN_SPACING_HOURS=24
INSTALLMENT_FEE_BPS=0
INSTALLMENT_DEFAULT_FEE_BPS=0
INSTALLMENT_GRACE_HOURS=24
# Packages on a payment plan are paid in full this many days before departure (ADR-028).
PACKAGE_BALANCE_DUE_DAYS=30
# Visa documents (ADR-026). `mock` flags the EICAR test file and is refused in production;
# `clamav` talks to clamd (docker compose --profile av up -d clamav).
ANTIVIRUS_PROVIDER=mock
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
VISA_DOCUMENT_MAX_BYTES=10000000
# Signed document links stay valid this long.
VISA_DOCUMENT_URL_TTL_SECONDS=300
# Documents are deleted this many days after their application closes.
VISA_DOCUMENT_RETENTION_DAYS=90
# Deleted accounts: bookings, payments and ledger entries are kept this long with contact details
# removed (ADR-029). Confirm the period with your accountant or counsel.
FINANCIAL_RECORDS_RETENTION_YEARS=7

# --- Accounts: price alerts, Prime reminders, referrals (ADR-030 to ADR-032) ----
PRICE_ALERT_INTERVAL_HOURS=6
# Notify when the price drops at least this much (basis points) since the last notice.
PRICE_ALERT_MIN_DROP_BPS=500
PRICE_ALERT_BATCH_SIZE=50
PRIME_REMINDER_DAYS=7
# Referral rewards in minor units; 0 tracks referrals without paying (owner decision).
REFERRAL_REWARD_REFERRER_MINOR=0
REFERRAL_REWARD_REFEREE_MINOR=0
REFERRAL_REWARD_CURRENCY=NGN
REFERRAL_MIN_SPEND_MINOR=0
REFERRAL_MONTHLY_CAP=10
# Staff refunds above this (NGN minor units) need a second approver; 0 = always (ADR-019).
REFUND_APPROVAL_THRESHOLD_NGN=0
REFUND_REVIEW_AFTER_HOURS=72
# Payment risk review (ADR-040): at or above the score a paid booking waits for finance.
PAYMENT_RISK_ENABLED=true
PAYMENT_RISK_REVIEW_SCORE=60
PAYMENT_RISK_MAX_PAYMENTS_PER_DAY=5
PAYMENT_RISK_MAX_ATTEMPTS_PER_IP=10
PAYMENT_RISK_MAX_CARDS=3
# Watched countries (ISO codes) and airport pairs (LOS-LHR), comma-separated.
PAYMENT_RISK_COUNTRIES=
PAYMENT_RISK_ROUTES=
# Header the edge sets with the client's country (cf-ipcountry behind Cloudflare). Leave blank
# unless the edge overwrites it on every request.
CLIENT_COUNTRY_HEADER=
# Money alerts for operations (automatic refunds, failures, reviews, defaults).
OPS_ALERT_EMAIL=
# Automatic ticketing attempts (backoff 1, 2, 4, 8, 16 min) before a paid booking needs a refund.
TICKETING_MAX_ATTEMPTS=6
# E-tickets and vouchers. `filesystem` is for development and tests (S3/GCS in phase 12).
OBJECT_STORAGE=filesystem
OBJECT_STORAGE_DIR=.data/objects
# Paystack signs webhooks with the secret key itself, so it needs no separate webhook secret.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you set on the Flutterwave dashboard (sent back as `verif-hash`).
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- FX, messaging ----------------------------------------------------------
# Exchange rates: only the mock provider (illustrative rates) exists until the owner picks a
# source (ADR-008); refused in production unless ALLOW_MOCK_PROVIDERS=true.
FX_PROVIDER=mock
FX_CACHE_TTL_SECONDS=3600
FX_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
# Email: `smtp` (Mailpit locally: open http://localhost:8025) or `mock` (in-memory, tests).
EMAIL_PROVIDER=smtp
EMAIL_FROM=Suskii Travels <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMS: only the mock adapter exists until a provider is contracted (codes are not sent).
SMS_PROVIDER=mock
# WhatsApp: likewise mock only until a WhatsApp Business provider is contracted (ADR-032).
WHATSAPP_PROVIDER=mock
# Push (ADR-022): `expo` relays through Expo's push service to FCM and APNs (credentials live in
# EAS); `mock` keeps messages in memory. The access token enables Expo's enhanced push security.
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=
# Staging only: allow mock email/SMS adapters when NODE_ENV=production.
ALLOW_MOCK_PROVIDERS=false

# --- Object storage ----------------------------------------------------------
S3_BUCKET=
S3_REGION=

# --- Bot protection (Cloudflare Turnstile, ADR-012) ----------------------------
# Leave both empty locally: the API then uses a mock verifier and the newsletter form skips the
# widget. Production requires the secret.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Mobile device attestation (ADR-023) ----------------------------------------
# The app's guest checkout proves itself with Play Integrity or App Attest instead of Turnstile.
# `mock` accepts only `mock:<challenge>` (development and e2e builds) and is refused in production;
# `none` rejects every attestation until real verifiers are configured with the owner's accounts.
DEVICE_ATTESTATION=mock
# Mobile login, registration and payment start: off, report (log only) or enforce (403).
ATTESTATION_MODE=off
# Oldest app version still served (MASVS-CODE-2); older apps get 426 and an update screen.
MOBILE_MIN_VERSION=

# --- Observability and analytics ---------------------------------------------
# Error reports (ADR-046). The API and the worker report with SENTRY_DSN; empty means errors are
# only logged. SENTRY_RELEASE is the deployed version (the git SHA) so reports match source maps.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# The website, the console and the app inline their DSN into the bundle (public by design).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
# OpenTelemetry traces (API) and metrics (API and worker) are exported only when an OTLP endpoint
# is set (ADR-047). Each service names itself (suskii-api, suskii-worker) unless this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# --- Client-side API base URLs (public, bundled into web/mobile) ------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Share of website page views that report field Core Web Vitals to the API (0 to 1, ADR-044).
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Mobile app build (apps/mobile, ADR-024) ---------------------------------
# EXPO_PUBLIC_* values are inlined into the app bundle and readable by anyone: never put a
# secret here (CI scans every bundle). Preview and production builds require https URLs.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
# `mock` only for development and e2e builds; production builds refuse it (ADR-023).
EXPO_PUBLIC_ATTESTATION=mock
# Google Cloud project number for Play Integrity (a public identifier). Owner decision.
EXPO_PUBLIC_PLAY_INTEGRITY_PROJECT_NUMBER=
# App Store page the update screen opens on iOS (https://apps.apple.com/app/id...). Owner decision.
EXPO_PUBLIC_IOS_APP_STORE_URL=
# development | preview | production | e2e (bundle id suffix, http allowed only for dev/e2e).
APP_VARIANT=development
# Store identity; placeholder until the owner registers the apps.
APP_BUNDLE_ID=com.suskii.travels
# EAS project id: enables Expo push tokens and EAS Update. Set by `eas init` (owner account).
EAS_PROJECT_ID=

# --- App links served by the web app (/.well-known, ADR-021) -----------------
MOBILE_APP_SCHEME=suskii
MOBILE_ANDROID_PACKAGE=
# Comma-separated SHA-256 fingerprints of the Play app signing certificate.
MOBILE_ANDROID_CERT_SHA256=
# Comma-separated TEAMID.bundle.id values for apple-app-site-association.
MOBILE_IOS_APP_IDS=

# --- Optional AI trip search (phase 13) --------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
