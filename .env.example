# ---------------------------------------------------------------------------
# Suskii Travels environment variables.
# Copy to `.env` (never commit it):   PowerShell: Copy-Item .env.example .env
#                                     bash/zsh:   cp .env.example .env
# Leave secrets empty until real credentials exist; mock adapters are used
# while a provider key is blank. Production secrets live in the cloud secret
# manager and are injected at runtime, never baked into images or app bundles.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
WORKER_HEALTH_PORT=4100

# --- Local infrastructure (docker-compose.yml) --------------------------------
# Local-only defaults; ports are bound to 127.0.0.1.
POSTGRES_USER=suskii
POSTGRES_PASSWORD=suskii_local_dev
POSTGRES_DB=suskii
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://suskii:suskii_local_dev@localhost:5432/suskii
REDIS_URL=redis://localhost:6379

# --- HTTP --------------------------------------------------------------------
# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Used in email links (verify email, reset password).
WEB_APP_URL=http://localhost:3000
# Reverse proxies (load balancer, Cloudflare) in front of the API; 0 locally.
TRUST_PROXY_HOPS=0

# --- Auth and encryption -----------------------------------------------------
# Generate every secret below with:  pnpm --filter @suskii/api keys:generate
# Blank values in development and tests use per-process ephemeral keys (sessions and MFA
# enrolments then stop working after a restart). Production refuses to start without them.
# Ed25519 access-token signing keys: PEM or base64 of the PEM.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Retired public keys still accepted during a key rotation (`|`-separated).
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# AES-256-GCM key for field-level encryption (32 bytes, base64) until the KMS adapter lands.
FIELD_ENCRYPTION_KEY=
# Master secret (>= 32 chars) for HMAC subkeys: IP hashing, CSRF tokens, OTP hashes.
HMAC_SECRET=
# Cloud KMS key used for envelope encryption of passport numbers and visa documents (phase 12).
ENCRYPTION_KMS_KEY_ID=
# Cookie attributes for the web transport. Local plain-HTTP development only: COOKIE_SECURE=false
# drops the __Secure- prefix. Production requires true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Social sign-in: OAuth client IDs (comma-separated). A provider stays disabled while blank.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Breached-password check (HIBP range API, k-anonymity).
HIBP_ENABLED=true
# Optional exact-IP allowlist for /v1/admin routes (comma-separated).
ADMIN_IP_ALLOWLIST=
RATE_LIMIT_ENABLED=true
# Local seed only (never production): creates a super admin; enrol MFA before using admin routes.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Suppliers and search -----------------------------------------------------
# Enabled suppliers (feature flags). `mock` returns synthetic, clearly labelled offers and is
# refused in production unless ALLOW_MOCK_PROVIDERS=true. `duffel` needs DUFFEL_API_TOKEN.
FLIGHT_SUPPLIERS=mock
HOTEL_SUPPLIERS=mock
DUFFEL_API_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
HOTEL_PROVIDER_API_KEY=
HOTEL_PROVIDER_SECRET=
# Whole-search budget and per-supplier timeout (ms); identical searches are cached (seconds).
SEARCH_TIMEOUT_MS=12000
SUPPLIER_TIMEOUT_MS=10000
SEARCH_CACHE_TTL_SECONDS=600
# Booking (ticketing) calls to a supplier get longer than searches (ms).
SUPPLIER_BOOKING_TIMEOUT_MS=45000
# Mock flight supplier only: routes whose price changes at the re-price right before payment, in
# basis points (ORIGIN-DESTINATION:bps, comma-separated), to walk through price-change consent.
MOCK_REPRICE_RULES=

# --- Deals, hotel destinations and the worker (ADR-011) -----------------------
# Service token for /v1/internal routes, shared by the API and the worker. The value below is for
# local development only and is refused in production; generate a real one with keys:generate.
INTERNAL_API_TOKEN=local-dev-only-internal-token-change-me
# Worker -> API base URL (server to server).
API_INTERNAL_URL=http://localhost:4000
# Deals and destination prices older than this are hidden; snapshots are kept for price history.
DEALS_MAX_AGE_HOURS=24
DEALS_DEPARTURE_OFFSETS_DAYS=21,45
DESTINATIONS_CHECK_IN_OFFSET_DAYS=30
SNAPSHOT_RETENTION_DAYS=7
# Worker schedules (minutes).
DEALS_REFRESH_INTERVAL_MINUTES=180
DESTINATIONS_REFRESH_INTERVAL_MINUTES=360

# --- Payments (test-mode keys only outside production) -----------------------
# Hosted-checkout providers in preference order (ADR-016): mock, paystack, flutterwave, stripe.
# The checkout offers those that settle the booking currency. `mock` (checkout page on the web
# app) is refused in production unless ALLOW_MOCK_PROVIDERS=true. Each real provider needs its
# keys below; register the webhook URL /v1/payments/webhooks/<provider> with the provider.
PAYMENT_PROVIDERS=mock
PAYMENT_SESSION_TTL_MINUTES=30
PAYMENT_PROVIDER_TIMEOUT_MS=15000
# Pending payments older than this are verified with the provider (lost webhooks).
PAYMENT_RECONCILE_AFTER_MINUTES=15
# Holds and installments (ADR-018). Fees and the default policy are owner decisions; 0 = none.
HOLD_MIN_WINDOW_HOURS=6
HOLD_SAFETY_MARGIN_MINUTES=120
HOLD_MAX_ACTIVE=2
INSTALLMENT_DEPOSIT_BPS=3000
INSTALLMENT_MAX_COUNT=3
INSTALLMENT_MIN_SPACING_HOURS=24
INSTALLMENT_FEE_BPS=0
INSTALLMENT_DEFAULT_FEE_BPS=0
INSTALLMENT_GRACE_HOURS=24
# Staff refunds above this (NGN minor units) need a second approver; 0 = always (ADR-019).
REFUND_APPROVAL_THRESHOLD_NGN=0
REFUND_REVIEW_AFTER_HOURS=72
# Money alerts for operations (automatic refunds, failures, reviews, defaults).
OPS_ALERT_EMAIL=
# Automatic ticketing attempts (backoff 1, 2, 4, 8, 16 min) before a paid booking needs a refund.
TICKETING_MAX_ATTEMPTS=6
# E-tickets and vouchers. `filesystem` is for development and tests (S3/GCS in phase 12).
OBJECT_STORAGE=filesystem
OBJECT_STORAGE_DIR=.data/objects
# Paystack signs webhooks with the secret key itself, so it needs no separate webhook secret.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you set on the Flutterwave dashboard (sent back as `verif-hash`).
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- FX, messaging ----------------------------------------------------------
# Exchange rates: only the mock provider (illustrative rates) exists until the owner picks a
# source (ADR-008); refused in production unless ALLOW_MOCK_PROVIDERS=true.
FX_PROVIDER=mock
FX_CACHE_TTL_SECONDS=3600
FX_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
# Email: `smtp` (Mailpit locally: open http://localhost:8025) or `mock` (in-memory, tests).
EMAIL_PROVIDER=smtp
EMAIL_FROM=Suskii Travels <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMS: only the mock adapter exists until a provider is contracted (codes are not sent).
SMS_PROVIDER=mock
# Staging only: allow mock email/SMS adapters when NODE_ENV=production.
ALLOW_MOCK_PROVIDERS=false

# --- Object storage ----------------------------------------------------------
S3_BUCKET=
S3_REGION=

# --- Bot protection (Cloudflare Turnstile, ADR-012) ----------------------------
# Leave both empty locally: the API then uses a mock verifier and the newsletter form skips the
# widget. Production requires the secret.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Observability and analytics ---------------------------------------------
SENTRY_DSN=
POSTHOG_KEY=
# OpenTelemetry traces are exported only when an OTLP endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=suskii-api

# --- Client-side API base URLs (public, bundled into web/mobile) ------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Optional AI trip search (phase 13) --------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
