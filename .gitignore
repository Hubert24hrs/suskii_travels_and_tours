# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
storybook-static/
.expo/
web-build/
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# Native projects are generated by EAS (continuous native generation)
apps/mobile/ios/
apps/mobile/android/

# Tooling caches
.turbo/
coverage/
