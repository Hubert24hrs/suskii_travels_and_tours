# Local object storage (e-tickets, vouchers) for development and tests
.data/

# Test output (Playwright, Lighthouse)
test-results/
playwright-report/
lighthouse-report/

# Env files: never commit secrets. Only the documented example is tracked.
.env
.env.*
!.env.example

# Logs and OS files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local certificates and keys
*.pem
*.key
*.p8
*.p12
*.mobileprovision
*.jks
*.keystore

# Generated Prisma client (`prisma generate` runs on install)
apps/api/src/generated/
