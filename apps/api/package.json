{
  "name": "@suskii/api",
  "version": "0.0.0",
  "private": true,
  "description": "Suskii Travels API: one NestJS backend shared by web, admin and mobile",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.mjs",
    "test:e2e:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.config.mjs --coverage",
    "clean": "rimraf dist .turbo coverage",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "openapi": "nest build && node dist/openapi/generate.js",
    "passwords:build": "tsx scripts/build-common-passwords.ts",
    "data:build": "tsx scripts/build-reference-data.ts",
    "keys:generate": "tsx scripts/generate-secrets.ts",
    "airlines:sync": "tsx scripts/sync-airlines.ts",
    "sessions:revoke": "tsx scripts/revoke-sessions.ts",
    "keys:reencrypt": "tsx scripts/reencrypt-fields.ts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/instrumentation": "catalog:",
    "@suskii/design-tokens": "workspace:*",
    "@suskii/shared": "workspace:*",
    "cookie-parser": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "nestjs-pino": "catalog:",
    "nodemailer": "catalog:",
    "pdf-lib": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "uqr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@photostructure/tz-lookup": "catalog:",
    "@suskii/config": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "csv-parse": "catalog:",
    "csv-stringify": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "jest": "catalog:",
    "pino-pretty": "catalog:",
    "prisma": "catalog:",
    "rimraf": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "ts-jest": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
