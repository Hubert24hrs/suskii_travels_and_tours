// Suskii Travels database schema. Conventions: UUIDv7 ids, snake_case tables and columns,
// timestamptz everywhere (UTC), no floats for money (money arrives in phase 3 as BIGINT minor units).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  disabled
  /// Anonymised on the owner's request (ADR-029); kept as a tombstone for financial records.
  deleted
}

enum RoleKey {
  customer
  super_admin
  operations
  finance
  support
  content_manager
  visa_officer
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Lower-cased and trimmed before storage.
  email           String?    @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// E.164, e.g. +2348012345678.
  phone           String?    @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// argon2id; null for OTP-only and social-only accounts.
  passwordHash    String?    @map("password_hash")
  displayName     String?    @map("display_name")
  status          UserStatus @default(active)
  /// When the account was anonymised (ADR-029).
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                   UserRole[]               @relation("UserRoles")
  sessions                Session[]
  mfaFactors              MfaFactor[]
  recoveryCodes           MfaRecoveryCode[]
  socialIdentities        SocialIdentity[]
  verificationTokens      VerificationToken[]
  bookings                Booking[]
  travellers              Traveller[]
  pushTokens              PushToken[]
  preferences             UserPreference?
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  memberships             PrimeMembership[]
  referralCode            ReferralCode?
  referralsMade           Referral[]               @relation("Referrer")
  referredBy              Referral?                @relation("Referee")
  priceAlerts             PriceAlert[]

  @@map("users")
}

model Role {
  key         RoleKey          @id
  description String
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  /// e.g. "bookings:read". The catalog lives in @suskii/shared and is synced by the seed.
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       RoleKey    @map("role_key")
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleKey     RoleKey  @map("role_key")
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedById String?  @map("granted_by_id") @db.Uuid
  user        User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleKey], references: [key])

  @@id([userId, roleKey])
  @@map("user_roles")
}

enum AuthMethod {
  password
  otp
  google
  apple
}

/// One signed-in device. Its refresh tokens form a rotation family.
model Session {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  authMethod    AuthMethod     @map("auth_method")
  userAgent     String?        @map("user_agent")
  /// HMAC of the client IP (never the raw address).
  ipHash        String?        @map("ip_hash")
  /// Set when MFA was completed for this session.
  mfaVerifiedAt DateTime?      @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?        @map("revoked_reason")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  pushTokens    PushToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the opaque token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token was exchanged for a new one; presenting it again is reuse.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum MfaFactorType {
  totp
}

model MfaFactor {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  type             MfaFactorType
  /// AES-256-GCM envelope (field encryption); never the plain secret.
  secretCiphertext String        @map("secret_ciphertext")
  confirmedAt      DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step, to reject replays.
  lastUsedStep     BigInt?       @map("last_used_step")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

enum SocialProvider {
  google
  apple
}

model SocialIdentity {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  provider  SocialProvider
  /// The provider's stable subject id (`sub` claim).
  subject   String
  email     String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("social_identities")
}

enum VerificationPurpose {
  email_verification
  password_reset
}

model VerificationToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Audit (append-only: UPDATE, DELETE and TRUNCATE are rejected by a trigger)
// ---------------------------------------------------------------------------

enum ActorType {
  user
  system
  anonymous
}

model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType   ActorType @map("actor_type")
  /// No foreign key: audit history must outlive user deletion or anonymisation.
  actorUserId String?   @map("actor_user_id") @db.Uuid
  /// Dotted event name, e.g. "auth.login.succeeded".
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  requestId   String?   @map("request_id")
  ipHash      String?   @map("ip_hash")
  userAgent   String?   @map("user_agent")
  metadata    Json      @default("{}")

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Idempotency (Idempotency-Key header on write endpoints, kept 24 hours)
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  in_progress
  completed
}

model IdempotencyKey {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// Who owns the key: "user:<id>" or "anon:<ip hash>". Keys never collide across callers.
  scope          String
  key            String
  /// SHA-256 of method, route and canonical body; a different payload under the same key is rejected.
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(in_progress)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Catalog (reference data)
// ---------------------------------------------------------------------------

enum AirportType {
  large_airport
  medium_airport
  small_airport
}

model Country {
  /// ISO 3166-1 alpha-2.
  code      String    @id @db.Char(2)
  name      String
  /// Two-letter continent code (AF, AN, AS, EU, NA, OC, SA).
  continent String    @db.Char(2)
  cities    City[]
  airports  Airport[]

  @@map("countries")
}

model City {
  id          String              @id @default(uuid(7)) @db.Uuid
  name        String
  countryCode String              @map("country_code") @db.Char(2)
  latitude    Float?
  longitude   Float?
  /// IANA time zone, e.g. Africa/Lagos.
  timezone    String?
  /// Accent-folded, lower-case "name country" for trigram autocomplete (set by the seed).
  searchText  String              @default("") @map("search_text")
  country     Country             @relation(fields: [countryCode], references: [code])
  airports    Airport[]
  destination DestinationContent?
  packages    TravelPackage[]
  tours       Tour[]

  @@unique([countryCode, name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "cities_search_text_trgm_idx")
  @@map("cities")
}

model Airport {
  iataCode         String      @id @map("iata_code") @db.Char(3)
  icaoCode         String?     @map("icao_code") @db.VarChar(4)
  name             String
  type             AirportType
  municipality     String?
  cityId           String?     @map("city_id") @db.Uuid
  countryCode      String      @map("country_code") @db.Char(2)
  latitude         Float
  longitude        Float
  /// IANA time zone; flight times are stored in UTC plus this zone.
  timezone         String
  scheduledService Boolean     @default(true) @map("scheduled_service")
  /// Accent-folded, lower-case "code name municipality country" for trigram autocomplete.
  searchText       String      @default("") @map("search_text")
  city             City?       @relation(fields: [cityId], references: [id])
  country          Country     @relation(fields: [countryCode], references: [code])
  dealOrigins      DealRoute[] @relation("DealRouteOrigin")
  dealDestinations DealRoute[] @relation("DealRouteDestination")

  @@index([countryCode])
  @@index([cityId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "airports_search_text_trgm_idx")
  @@map("airports")
}

/// Populated from the flight supplier's reference data (phase 3, ADR-006).
model Airline {
  id          String   @id @default(uuid(7)) @db.Uuid
  iataCode    String   @unique @map("iata_code") @db.VarChar(3)
  icaoCode    String?  @map("icao_code") @db.VarChar(4)
  name        String
  countryCode String?  @map("country_code") @db.Char(2)
  logoUrl     String?  @map("logo_url")
  active      Boolean  @default(true)
  /// Where the record came from, e.g. "duffel".
  source      String
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("airlines")
}

// ---------------------------------------------------------------------------
// Pricing (rules are managed in the admin console, phase 10; none are seeded)
// ---------------------------------------------------------------------------

enum Vertical {
  flights
  hotels
  packages
  tours
  visa
  travel_addons
  /// Suskii Prime membership purchases (ADR-030).
  prime
}

enum CabinClass {
  economy
  premium_economy
  business
  first
}

enum SalesChannel {
  web
  mobile
}

enum UserTier {
  guest
  member
  prime
}

enum AdjustmentType {
  percentage
  fixed
}

enum FeeBasis {
  per_booking
  per_passenger
}

/// Hidden margin on the supplier fare. The first active rule that matches (lowest priority
/// number) applies; rules never stack. Null conditions match anything.
model MarkupRule {
  id                 String         @id @default(uuid(7)) @db.Uuid
  name               String
  vertical           Vertical
  priority           Int            @default(100)
  active             Boolean        @default(true)
  channel            SalesChannel?
  userTier           UserTier?      @map("user_tier")
  supplier           String?
  originCode         String?        @map("origin_code") @db.VarChar(3)
  destinationCode    String?        @map("destination_code") @db.VarChar(3)
  originCountry      String?        @map("origin_country") @db.Char(2)
  destinationCountry String?        @map("destination_country") @db.Char(2)
  carrierCode        String?        @map("carrier_code") @db.VarChar(3)
  cabinClass         CabinClass?    @map("cabin_class")
  type               AdjustmentType
  /// Basis points for percentages (250 = 2.5%), minor units of `currency` for fixed amounts.
  value              BigInt
  /// Currency of a fixed value and of the caps.
  currency           String?        @db.Char(3)
  minAmountMinor     BigInt?        @map("min_amount_minor")
  maxAmountMinor     BigInt?        @map("max_amount_minor")
  validFrom          DateTime?      @map("valid_from") @db.Timestamptz(3)
  validTo            DateTime?      @map("valid_to") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([vertical, active, priority])
  @@map("markup_rules")
}

/// Customer-visible fees (e.g. service fee). Every active matching rule applies.
model FeeRule {
  id             String         @id @default(uuid(7)) @db.Uuid
  /// Stable machine code, e.g. "service_fee".
  code           String
  /// Customer-facing label.
  label          String
  vertical       Vertical
  active         Boolean        @default(true)
  sortOrder      Int            @default(0) @map("sort_order")
  channel        SalesChannel?
  userTier       UserTier?      @map("user_tier")
  type           AdjustmentType
  value          BigInt
  currency       String?        @db.Char(3)
  basis          FeeBasis       @default(per_booking)
  minAmountMinor BigInt?        @map("min_amount_minor")
  maxAmountMinor BigInt?        @map("max_amount_minor")
  validFrom      DateTime?      @map("valid_from") @db.Timestamptz(3)
  validTo        DateTime?      @map("valid_to") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([vertical, active])
  @@map("fee_rules")
}

model PromoCode {
  id                    String            @id @default(uuid(7)) @db.Uuid
  /// Stored upper-case; matched case-insensitively.
  code                  String            @unique
  description           String?
  type                  AdjustmentType
  /// Basis points for percentages, minor units of `currency` for fixed discounts.
  value                 BigInt
  /// Currency of a fixed value, the cap and the minimum spend.
  currency              String?           @db.Char(3)
  maxDiscountMinor      BigInt?           @map("max_discount_minor")
  minSpendMinor         BigInt?           @map("min_spend_minor")
  /// Empty means every vertical.
  verticals             Vertical[]
  validFrom             DateTime?         @map("valid_from") @db.Timestamptz(3)
  validTo               DateTime?         @map("valid_to") @db.Timestamptz(3)
  maxRedemptions        Int?              @map("max_redemptions")
  maxRedemptionsPerUser Int?              @map("max_redemptions_per_user")
  requiresAccount       Boolean           @default(false) @map("requires_account")
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  redemptions           PromoRedemption[]

  @@map("promo_codes")
}

/// Written when a booking is paid (phase 6); counted for usage limits.
model PromoRedemption {
  id          String    @id @default(uuid(7)) @db.Uuid
  promoCodeId String    @map("promo_code_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  bookingId   String?   @map("booking_id") @db.Uuid
  amountMinor BigInt    @map("amount_minor")
  currency    String    @db.Char(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  @@index([promoCodeId, userId])
  @@map("promo_redemptions")
}

// ---------------------------------------------------------------------------
// Search and offers
// ---------------------------------------------------------------------------

/// A supplier offer re-priced for checkout. Bookings (phase 5) are created from these.
model Offer {
  id                 String        @id @default(uuid(7)) @db.Uuid
  vertical           Vertical
  supplier           String
  supplierOfferId    String        @map("supplier_offer_id")
  /// Normalised offer in our domain shape (never raw vendor JSON).
  payload            Json
  supplierTotalMinor BigInt        @map("supplier_total_minor")
  supplierCurrency   String        @map("supplier_currency") @db.Char(3)
  /// Customer price breakdown at quote time.
  price              Json
  totalMinor         BigInt        @map("total_minor")
  currency           String        @db.Char(3)
  searchId           String?       @map("search_id")
  userId             String?       @map("user_id") @db.Uuid
  expiresAt          DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  bookingItems       BookingItem[]

  @@index([supplier, supplierOfferId])
  @@index([expiresAt])
  @@map("offers")
}

/// Anonymised search analytics: no user, session or IP; only what was searched and how it went.
model SearchLog {
  id               String        @id @default(uuid(7)) @db.Uuid
  occurredAt       DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  vertical         Vertical
  origin           String?       @db.VarChar(3)
  destination      String?       @db.VarChar(64)
  departureDate    DateTime?     @map("departure_date") @db.Date
  returnDate       DateTime?     @map("return_date") @db.Date
  sliceCount       Int?          @map("slice_count")
  travellers       Int
  cabinClass       CabinClass?   @map("cabin_class")
  channel          SalesChannel?
  cacheHit         Boolean       @map("cache_hit")
  partial          Boolean
  resultCount      Int           @map("result_count")
  durationMs       Int           @map("duration_ms")
  supplierOutcomes Json          @map("supplier_outcomes")

  @@index([vertical, occurredAt])
  @@index([origin, destination])
  @@map("search_logs")
}

// ---------------------------------------------------------------------------
// CMS
// ---------------------------------------------------------------------------

/// Marketing trust claims. Only rows with verified = true may ever be rendered (brand guardrails).
model TrustSignal {
  key         String    @id
  label       String
  value       String?
  verified    Boolean   @default(false)
  evidenceUrl String?   @map("evidence_url")
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)
  verifiedBy  String?   @map("verified_by") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("trust_signals")
}

model CmsBlock {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String
  locale      String    @default("en-NG")
  content     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([key, locale])
  @@map("cms_blocks")
}

model Faq {
  id          String    @id @default(uuid(7)) @db.Uuid
  locale      String    @default("en-NG")
  question    String
  answer      String
  sortOrder   Int       @default(0) @map("sort_order")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([locale, sortOrder])
  @@map("faqs")
}

// ---------------------------------------------------------------------------
// Deals and hotel destinations (phase 4, ADR-011)
// ---------------------------------------------------------------------------

/// Popular routes the deals worker keeps fresh. Configuration, managed in the admin console.
model DealRoute {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// URL slug of the SEO route page, e.g. lagos-to-london.
  slug            String         @unique
  originCode      String         @map("origin_code") @db.Char(3)
  destinationCode String         @map("destination_code") @db.Char(3)
  cabinClass      CabinClass     @default(economy) @map("cabin_class")
  /// Nights between the outbound and return flights.
  stayNights      Int            @default(7) @map("stay_nights")
  active          Boolean        @default(true)
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  origin          Airport        @relation("DealRouteOrigin", fields: [originCode], references: [iataCode])
  destination     Airport        @relation("DealRouteDestination", fields: [destinationCode], references: [iataCode])
  snapshots       DealSnapshot[]

  @@unique([originCode, destinationCode, cabinClass])
  @@index([active, sortOrder])
  @@map("deal_routes")
}

/// Cheapest fare found by one refresh. Supplier price plus the context markup rules need; the
/// customer price is computed on read (current rules, display currency, channel).
model DealSnapshot {
  id                 String    @id @default(uuid(7)) @db.Uuid
  routeId            String    @map("route_id") @db.Uuid
  supplier           String
  departureDate      DateTime  @map("departure_date") @db.Date
  returnDate         DateTime? @map("return_date") @db.Date
  carrierCode        String    @map("carrier_code") @db.VarChar(3)
  carrierName        String    @map("carrier_name")
  /// Outbound slice.
  stops              Int
  durationMinutes    Int       @map("duration_minutes")
  baseMinor          BigInt    @map("base_minor")
  taxesMinor         BigInt    @map("taxes_minor")
  currency           String    @db.Char(3)
  originCountry      String    @map("origin_country") @db.Char(2)
  destinationCountry String    @map("destination_country") @db.Char(2)
  fetchedAt          DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  route              DealRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, fetchedAt(sort: Desc)])
  @@index([fetchedAt])
  @@map("deal_snapshots")
}

/// CMS destination content (spec entity DestinationContent). Featured ones appear on the homepage.
model DestinationContent {
  id             String                     @id @default(uuid(7)) @db.Uuid
  cityId         String                     @unique @map("city_id") @db.Uuid
  /// URL slug of the SEO city page, e.g. cape-town.
  slug           String                     @unique
  featured       Boolean                    @default(false)
  sortOrder      Int                        @default(0) @map("sort_order")
  /// Licensed photo URL; the web shows an illustration while it is empty.
  imageUrl       String?                    @map("image_url")
  publishedAt    DateTime?                  @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  city           City                       @relation(fields: [cityId], references: [id])
  hotelSnapshots DestinationHotelSnapshot[]

  @@index([featured, sortOrder])
  @@map("destination_contents")
}

/// Hotel availability and the cheapest rate found by one refresh (supplier price for the stay).
model DestinationHotelSnapshot {
  id            String             @id @default(uuid(7)) @db.Uuid
  destinationId String             @map("destination_id") @db.Uuid
  supplier      String
  checkIn       DateTime           @map("check_in") @db.Date
  checkOut      DateTime           @map("check_out") @db.Date
  hotelCount    Int                @map("hotel_count")
  baseMinor     BigInt             @map("base_minor")
  taxesMinor    BigInt             @map("taxes_minor")
  currency      String             @db.Char(3)
  countryCode   String             @map("country_code") @db.Char(2)
  fetchedAt     DateTime           @default(now()) @map("fetched_at") @db.Timestamptz(3)
  destination   DestinationContent @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, fetchedAt(sort: Desc)])
  @@index([fetchedAt])
  @@map("destination_hotel_snapshots")
}

// ---------------------------------------------------------------------------
// Newsletter (phase 4, ADR-012)
// ---------------------------------------------------------------------------

enum NewsletterStatus {
  pending
  confirmed
  unsubscribed
}

enum WhatsappOptInStatus {
  pending_verification
  verified
}

/// Deal-alert subscription with a provable consent record and double opt-in.
model NewsletterSubscription {
  id                    String               @id @default(uuid(7)) @db.Uuid
  /// Lower-cased and trimmed before storage.
  email                 String               @unique
  status                NewsletterStatus     @default(pending)
  locale                String               @default("en-NG")
  /// E.164. Stored only with an explicit opt-in; nothing is sent until it is verified.
  whatsappPhone         String?              @map("whatsapp_phone")
  whatsappStatus        WhatsappOptInStatus? @map("whatsapp_status")
  consentVersion        String               @map("consent_version")
  consentedAt           DateTime             @map("consented_at") @db.Timestamptz(3)
  /// Keyed hash of the IP the consent came from (proof without keeping the address).
  consentIpHash         String?              @map("consent_ip_hash")
  source                String               @default("homepage")
  /// SHA-256 of the confirmation token; the token itself only exists in the email.
  confirmTokenHash      String?              @unique @map("confirm_token_hash")
  confirmTokenExpiresAt DateTime?            @map("confirm_token_expires_at") @db.Timestamptz(3)
  confirmationSentAt    DateTime?            @map("confirmation_sent_at") @db.Timestamptz(3)
  confirmedAt           DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  unsubscribedAt        DateTime?            @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("newsletter_subscriptions")
}

// ---------------------------------------------------------------------------
// Bookings, payments and documents (phase 5, ADR-014 and ADR-015)
// ---------------------------------------------------------------------------

enum BookingStatus {
  DRAFT
  PRICED
  HELD
  AWAITING_PAYMENT
  PARTIALLY_PAID
  PAID
  TICKETING
  CONFIRMED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  EXPIRED
}

enum BookingItemType {
  flight
  hotel
  package
  tour
  visa
  addon
  membership
}

/// Where a booking item's seats on a departure stand (ADR-025).
enum SeatState {
  reserved
  sold
  released
}

enum PassengerType {
  adult
  child
  infant
}

enum BookingActorType {
  customer
  system
  webhook
  staff
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
  expired
}

enum BookingDocumentType {
  e_ticket
  hotel_voucher
  package_voucher
  tour_voucher
  addon_voucher
  visa_confirmation
}

/// One purchase: a flight or a hotel stay now, several items later (packages, add-ons).
model Booking {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// Short public reference: 6 characters without look-alike letters.
  reference         String        @unique
  status            BookingStatus @default(DRAFT)
  vertical          Vertical
  userId            String?       @map("user_id") @db.Uuid
  /// HMAC of the guest access token (ADR-015); null for account bookings.
  accessTokenHash   String?       @unique @map("access_token_hash")
  /// JSON { email, phone } encrypted with the context `booking:{id}:contact`.
  contactEncrypted  String        @map("contact_encrypted")
  /// HMAC of the contact email, for lookup without decrypting.
  contactEmailHash  String        @map("contact_email_hash")
  currency          String        @db.Char(3)
  totalMinor        BigInt        @map("total_minor")
  /// Customer price breakdown at the agreed price (fare, extras, discount, total).
  price             Json
  /// Re-priced breakdown waiting for the traveller's consent.
  pendingPrice      Json?         @map("pending_price")
  promoCodeId       String?       @map("promo_code_id") @db.Uuid
  channel           SalesChannel
  locale            String        @default("en-NG")
  termsVersion      String        @map("terms_version")
  termsAcceptedAt   DateTime      @map("terms_accepted_at") @db.Timestamptz(3)
  /// Unpaid bookings expire at this instant.
  paymentDeadline   DateTime?     @map("payment_deadline") @db.Timestamptz(3)
  ticketingAttempts Int           @default(0) @map("ticketing_attempts")
  nextTicketingAt   DateTime?     @map("next_ticketing_at") @db.Timestamptz(3)
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  /// The booking an add-on belongs to (ADR-027); add-ons are their own bookings.
  linkedBookingId   String?       @map("linked_booking_id") @db.Uuid
  /// Set once the check-in reminder went out (ADR-032).
  checkinRemindedAt DateTime?     @map("checkin_reminded_at") @db.Timestamptz(3)
  /// Contact details and passports wiped after account deletion (ADR-029).
  redactedAt        DateTime?     @map("redacted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedBooking    Booking?               @relation("LinkedAddons", fields: [linkedBookingId], references: [id], onDelete: SetNull)
  addons           Booking[]              @relation("LinkedAddons")
  vouchers         BookingVoucher[]
  visaApplications VisaApplication[]
  items            BookingItem[]
  passengers       BookingPassenger[]
  history          BookingStatusHistory[]
  payments         Payment[]
  documents        BookingDocument[]
  paymentPlan      PaymentPlan?
  refunds          Refund[]
  accessLinks      BookingAccessLink[]
  pushTokens       PushToken[]
  notes            BookingNote[]

  @@index([userId, createdAt])
  /// Admin booking search and the dashboard filter by creation date (ADR-036).
  @@index([createdAt])
  @@index([status, paymentDeadline])
  @@index([status, nextTicketingAt])
  @@index([contactEmailHash])
  @@index([linkedBookingId])
  @@map("bookings")
}

model BookingItem {
  id                   String          @id @default(uuid(7)) @db.Uuid
  bookingId            String          @map("booking_id") @db.Uuid
  type                 BookingItemType
  offerId              String          @map("offer_id") @db.Uuid
  supplier             String
  supplierOfferId      String          @map("supplier_offer_id")
  /// Offer snapshot in our domain shape, as priced for this booking.
  payload              Json
  /// Extras chosen at checkout: [{ serviceId, passengerIndex, quantity }].
  services             Json            @default("[]")
  totalMinor           BigInt          @map("total_minor")
  currency             String          @db.Char(3)
  /// Airline PNR or hotel confirmation number, once booked (or held) with the supplier.
  supplierReference    String?         @map("supplier_reference")
  /// Supplier order id of a held booking (Duffel `pay_later` order), paid at ticketing.
  supplierOrderId      String?         @map("supplier_order_id")
  /// The supplier releases the held space at this instant.
  heldUntil            DateTime?       @map("held_until") @db.Timestamptz(3)
  /// The supplier guarantees the held price until this instant.
  priceGuaranteedUntil DateTime?       @map("price_guaranteed_until") @db.Timestamptz(3)
  /// [{ passengerIndex, number }] for flights.
  ticketNumbers        Json?           @map("ticket_numbers")
  bookedAt             DateTime?       @map("booked_at") @db.Timestamptz(3)
  /// Package or tour departure whose seats this item holds (ADR-025).
  packageDepartureId   String?         @map("package_departure_id") @db.Uuid
  tourDepartureId      String?         @map("tour_departure_id") @db.Uuid
  seats                Int?
  seatState            SeatState?      @map("seat_state")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offer            Offer             @relation(fields: [offerId], references: [id], onDelete: Restrict)
  packageDeparture PackageDeparture? @relation(fields: [packageDepartureId], references: [id], onDelete: Restrict)
  tourDeparture    TourDeparture?    @relation(fields: [tourDepartureId], references: [id], onDelete: Restrict)
  vouchers         BookingVoucher[]

  @@index([bookingId])
  @@index([packageDepartureId])
  @@index([tourDepartureId])
  @@map("booking_items")
}

/// A flight passenger or a hotel room's lead guest (then only names and `roomIndex`).
model BookingPassenger {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  position          Int
  type              PassengerType
  title             String?
  gender            String?
  /// Passport (machine-readable) form, e.g. ADEBAYO CHIOMA.
  givenNames        String        @map("given_names")
  surname           String
  dateOfBirth       DateTime?     @map("date_of_birth") @db.Date
  nationality       String?       @db.Char(2)
  /// Encrypted with `booking-passenger:{id}:passport`.
  passportEncrypted String?       @map("passport_encrypted")
  /// Last three characters, for display.
  documentHint      String?       @map("document_hint")
  issuingCountry    String?       @map("issuing_country") @db.Char(2)
  documentExpiry    DateTime?     @map("document_expiry") @db.Date
  travellerId       String?       @map("traveller_id") @db.Uuid
  roomIndex         Int?          @map("room_index")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  @@map("booking_passengers")
}

/// Every status change, append-only (also mirrored to the audit log).
model BookingStatusHistory {
  id          String           @id @default(uuid(7)) @db.Uuid
  bookingId   String           @map("booking_id") @db.Uuid
  fromStatus  BookingStatus?   @map("from_status")
  toStatus    BookingStatus    @map("to_status")
  event       String
  reason      String?
  actorType   BookingActorType @map("actor_type")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  occurredAt  DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, occurredAt])
  @@map("booking_status_history")
}

/// Saved passengers of an account (at most 20 per user).
model Traveller {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  title             String
  gender            String
  givenNames        String    @map("given_names")
  surname           String
  dateOfBirth       DateTime  @map("date_of_birth") @db.Date
  nationality       String    @db.Char(2)
  /// Encrypted with `traveller:{id}:passport`.
  passportEncrypted String?   @map("passport_encrypted")
  documentHint      String?   @map("document_hint")
  issuingCountry    String?   @map("issuing_country") @db.Char(2)
  documentExpiry    DateTime? @map("document_expiry") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("travellers")
}

enum PaymentKind {
  checkout
  wallet
}

model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  kind                  PaymentKind   @default(checkout)
  provider              String
  providerReference     String        @unique @map("provider_reference")
  /// Provider's own id for the charge (refunds and verification use it).
  providerTransactionId String?       @map("provider_transaction_id")
  status                PaymentStatus @default(pending)
  amountMinor           BigInt        @map("amount_minor")
  currency              String        @db.Char(3)
  /// Hosted checkout page; null for wallet payments.
  checkoutUrl           String?       @map("checkout_url")
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz(3)
  succeededAt           DateTime?     @map("succeeded_at") @db.Timestamptz(3)
  failureReason         String?       @map("failure_reason")
  /// Channel reported by the provider (card, bank_transfer, ussd...). Never card details.
  method                String?
  /// The installment this payment pays, for payment plans.
  installmentId         String?       @map("installment_id") @db.Uuid
  /// Money received that the booking could not take (duplicate, mismatch, too late); refunded automatically.
  requiresRefund        Boolean       @default(false) @map("requires_refund")
  /// Last time the worker asked the provider about this pending payment.
  reconciledAt          DateTime?     @map("reconciled_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  refunds     Refund[]

  @@index([bookingId])
  @@index([status, expiresAt])
  @@map("payments")
}

/// Provider webhooks, deduplicated by the provider's event id. Normalised fields only, never card data.
model WebhookEvent {
  id                String    @id @default(uuid(7)) @db.Uuid
  provider          String
  eventId           String    @map("event_id")
  type              String
  providerReference String?   @map("provider_reference")
  payload           Json
  outcome           String?
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model BookingDocument {
  id          String              @id @default(uuid(7)) @db.Uuid
  bookingId   String              @map("booking_id") @db.Uuid
  type        BookingDocumentType
  storageKey  String              @map("storage_key")
  fileName    String              @map("file_name")
  contentType String              @map("content_type")
  sizeBytes   Int                 @map("size_bytes")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@map("booking_documents")
}

// ---------------------------------------------------------------------------
// Ledger, payment plans, refunds and access links (phase 6, ADR-016 to ADR-019)
// ---------------------------------------------------------------------------

enum LedgerAccountType {
  asset
  liability
  income
  expense
}

enum LedgerDirection {
  debit
  credit
}

/// A ledger account (ADR-017). The balance is maintained by a trigger on `ledger_entries`, in the
/// account's normal direction, and can only go negative when `allowNegative` is set.
model LedgerAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  /// e.g. `booking:{id}:NGN`, `wallet:{userId}:NGN`, `psp:paystack:NGN`.
  code          String            @unique
  type          LedgerAccountType
  currency      String            @db.Char(3)
  allowNegative Boolean           @default(false) @map("allow_negative")
  balanceMinor  BigInt            @default(0) @map("balance_minor")
  userId        String?           @map("user_id") @db.Uuid
  bookingId     String?           @map("booking_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([userId])
  @@index([bookingId])
  @@map("ledger_accounts")
}

/// One balanced money movement, posted once per idempotency key. Append-only.
model LedgerTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  kind           String
  bookingId      String?  @map("booking_id") @db.Uuid
  paymentId      String?  @map("payment_id") @db.Uuid
  refundId       String?  @map("refund_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([bookingId])
  @@index([paymentId])
  /// Dashboard money figures sum entries by transaction kind and period (ADR-036).
  @@index([kind, createdAt])
  @@map("ledger_transactions")
}

/// Append-only. Debits equal credits per transaction and currency (checked at commit).
model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  direction     LedgerDirection
  amountMinor   BigInt          @map("amount_minor")
  currency      String          @db.Char(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

enum PaymentPlanKind {
  hold
  installments
}

enum PaymentPlanStatus {
  active
  completed
  defaulted
  cancelled
  expired
}

enum InstallmentStatus {
  pending
  paid
  cancelled
}

/// Reserve now and pay later, or a deposit plus installments, on a held booking (ADR-018).
model PaymentPlan {
  id            String            @id @default(uuid(7)) @db.Uuid
  bookingId     String            @unique @map("booking_id") @db.Uuid
  kind          PaymentPlanKind
  status        PaymentPlanStatus @default(active)
  currency      String            @db.Char(3)
  /// Everything the traveller pays over the plan, fee included.
  totalMinor    BigInt            @map("total_minor")
  feeMinor      BigInt            @default(0) @map("fee_minor")
  graceHours    Int               @map("grace_hours")
  /// Policy fee kept on default, in basis points of the amount paid.
  defaultFeeBps Int               @map("default_fee_bps")
  /// Our deadline for full payment (the supplier's minus a safety margin).
  deadline      DateTime          @db.Timestamptz(3)
  closedAt      DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([status, deadline])
  @@map("payment_plans")
}

model Installment {
  id               String            @id @default(uuid(7)) @db.Uuid
  planId           String            @map("plan_id") @db.Uuid
  /// 0 is the deposit (or the whole amount of a hold).
  sequence         Int
  dueAt            DateTime          @map("due_at") @db.Timestamptz(3)
  amountMinor      BigInt            @map("amount_minor")
  currency         String            @db.Char(3)
  status           InstallmentStatus @default(pending)
  paidAt           DateTime?         @map("paid_at") @db.Timestamptz(3)
  reminder3dSentAt DateTime?         @map("reminder_3d_sent_at") @db.Timestamptz(3)
  reminder1dSentAt DateTime?         @map("reminder_1d_sent_at") @db.Timestamptz(3)

  plan     PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([planId, sequence])
  @@index([status, dueAt])
  @@map("installments")
}

enum RefundStatus {
  pending_approval
  approved
  processing
  succeeded
  failed
  rejected
  needs_review
}

enum RefundDestination {
  original
  wallet
}

enum RefundReason {
  duplicate_payment
  amount_mismatch
  late_payment
  ticketing_failed
  installment_default
  customer_cancellation
  goodwill
  supplier_cancellation
  other
}

/// Money going back for one payment (ADR-019).
model Refund {
  id                String            @id @default(uuid(7)) @db.Uuid
  bookingId         String            @map("booking_id") @db.Uuid
  paymentId         String            @map("payment_id") @db.Uuid
  provider          String
  amountMinor       BigInt            @map("amount_minor")
  currency          String            @db.Char(3)
  destination       RefundDestination
  reason            RefundReason
  status            RefundStatus
  /// Computed by the system (no discretion) rather than requested by staff.
  automatic         Boolean           @default(false)
  /// Ledger source: `booking` (customer money for the booking) or `unapplied`.
  source            String
  cancelsBooking    Boolean           @default(false) @map("cancels_booking")
  /// Staff note; never copied to logs or audit metadata.
  note              String?
  requestedByUserId String?           @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?           @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?         @map("approved_at") @db.Timestamptz(3)
  rejectionReason   String?           @map("rejection_reason")
  providerRefundId  String?           @map("provider_refund_id")
  failureReason     String?           @map("failure_reason")
  attempts          Int               @default(0)
  processedAt       DateTime?         @map("processed_at") @db.Timestamptz(3)
  settledAt         DateTime?         @map("settled_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@index([status, updatedAt])
  @@index([bookingId])
  @@map("refunds")
}

/// Expiring links that open a guest booking from an email (ADR-018). Only the HMAC is stored.
model BookingAccessLink {
  id        String   @id @default(uuid(7)) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  purpose   String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_access_links")
}

enum PushPlatform {
  ios
  android
}

/// A device push token (ADR-022). The token is encrypted with the context `push-token:{id}` and
/// looked up by HMAC. It belongs to an account session (pushes stop when the session ends) or to
/// one booking (guests).
model PushToken {
  id             String       @id @default(uuid(7)) @db.Uuid
  tokenHash      String       @map("token_hash")
  tokenEncrypted String       @map("token_encrypted")
  platform       PushPlatform
  /// `session:{id}` or `booking:{id}`: one row per device and scope.
  scope          String
  userId         String?      @map("user_id") @db.Uuid
  sessionId      String?      @map("session_id") @db.Uuid
  bookingId      String?      @map("booking_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([tokenHash, scope])
  @@index([userId])
  @@index([sessionId])
  @@index([bookingId])
  @@map("push_tokens")
}

// ---------------------------------------------------------------------------
// In-house catalog: packages, tours, add-ons, visa assistance (phase 8, ADR-025 to ADR-028)
// ---------------------------------------------------------------------------

enum CatalogStatus {
  draft
  published
  archived
}

enum DepartureStatus {
  open
  closed
  cancelled
}

enum AddonProductType {
  insurance
  airport_transfer
  esim
  lounge
}

enum AddonPricingBasis {
  per_person
  per_booking
  per_day
  per_person_per_day
}

enum VisaPurpose {
  tourism
  business
  study
  transit
}

enum VisaRequirement {
  visa_free
  visa_on_arrival
  e_visa
  visa_required
  not_available
}

enum VisaApplicationStatus {
  awaiting_documents
  submitted
  in_review
  action_required
  lodged
  approved
  refused
  withdrawn
}

enum VisaDocumentStatus {
  pending_scan
  clean
  infected
  scan_failed
  rejected
}

/// A curated holiday package: flights, hotel and extras described as inclusions (ADR-025).
model TravelPackage {
  id                 String        @id @default(uuid(7)) @db.Uuid
  slug               String        @unique
  status             CatalogStatus @default(draft)
  /// Demo inventory from `db:seed:demo`; shown with a "Sample" badge.
  sample             Boolean       @default(false)
  featured           Boolean       @default(false)
  title              String
  summary            String
  cityId             String        @map("city_id") @db.Uuid
  countryCode        String        @map("country_code") @db.Char(2)
  nights             Int
  /// Travellers must give passport details at checkout (on unless staff turn it off).
  passportRequired   Boolean       @default(true) @map("passport_required")
  /// Card art key under the web app's /art route.
  artKey             String?       @map("art_key")
  highlights         Json          @default("[]")
  itinerary          Json          @default("[]")
  inclusions         Json          @default("[]")
  exclusions         Json          @default("[]")
  /// [{ daysBefore, refundBps }] (ADR-028).
  cancellationPolicy Json          @map("cancellation_policy")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  city       City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  departures PackageDeparture[]

  @@index([status, countryCode])
  @@index([cityId])
  @@map("packages")
}

/// A dated departure of a package with its capacity and per-person base prices.
model PackageDeparture {
  id             String          @id @default(uuid(7)) @db.Uuid
  packageId      String          @map("package_id") @db.Uuid
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  capacity       Int
  seatsReserved  Int             @default(0) @map("seats_reserved")
  seatsSold      Int             @default(0) @map("seats_sold")
  /// { adult, child, infant } wire money (child and infant may be null).
  prices         Json
  currency       String          @db.Char(3)
  /// Adult base price, for sorting and budget filters.
  fromPriceMinor BigInt          @map("from_price_minor")
  status         DepartureStatus @default(open)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  package      TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([packageId, startDate])
  @@index([status, startDate])
  @@map("package_departures")
}

/// A tour or activity with a meeting point and dated departures.
model Tour {
  id                 String        @id @default(uuid(7)) @db.Uuid
  slug               String        @unique
  status             CatalogStatus @default(draft)
  sample             Boolean       @default(false)
  featured           Boolean       @default(false)
  title              String
  summary            String
  cityId             String        @map("city_id") @db.Uuid
  countryCode        String        @map("country_code") @db.Char(2)
  /// IANA zone of the meeting point; departures are stored in its wall time and in UTC.
  timeZone           String        @map("time_zone")
  durationMinutes    Int           @map("duration_minutes")
  category           String?
  artKey             String?       @map("art_key")
  meetingPoint       Json          @map("meeting_point")
  highlights         Json          @default("[]")
  inclusions         Json          @default("[]")
  exclusions         Json          @default("[]")
  cancellationPolicy Json          @map("cancellation_policy")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  city       City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  departures TourDeparture[]

  @@index([status, countryCode])
  @@index([cityId])
  @@map("tours")
}

model TourDeparture {
  id             String          @id @default(uuid(7)) @db.Uuid
  tourId         String          @map("tour_id") @db.Uuid
  /// Wall time at the meeting point, YYYY-MM-DDTHH:mm.
  startsAtLocal  String          @map("starts_at_local")
  startsAtUtc    DateTime        @map("starts_at_utc") @db.Timestamptz(3)
  capacity       Int
  seatsReserved  Int             @default(0) @map("seats_reserved")
  seatsSold      Int             @default(0) @map("seats_sold")
  prices         Json
  currency       String          @db.Char(3)
  fromPriceMinor BigInt          @map("from_price_minor")
  status         DepartureStatus @default(open)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tour         Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([tourId, startsAtUtc])
  @@index([status, startsAtUtc])
  @@map("tour_departures")
}

/// Insurance, airport transfer, eSIM or lounge access sold by Suskii (ADR-027).
model Addon {
  id                 String            @id @default(uuid(7)) @db.Uuid
  slug               String            @unique
  status             CatalogStatus     @default(draft)
  sample             Boolean           @default(false)
  type               AddonProductType
  title              String
  summary            String
  description        String
  /// Countries where it applies; empty means anywhere.
  countryCodes       String[]          @map("country_codes") @db.Char(2)
  pricingBasis       AddonPricingBasis @map("pricing_basis")
  /// Base unit price, wire money.
  price              Json
  currency           String            @db.Char(3)
  priceMinor         BigInt            @map("price_minor")
  maxTravellers      Int               @default(9) @map("max_travellers")
  /// AddonDetailField[] collected at checkout.
  requiredDetails    Json              @default("[]") @map("required_details")
  cancellationPolicy Json              @map("cancellation_policy")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, type])
  @@map("addons")
}

/// Eligibility for nationality x destination x purpose, maintained by visa officers (ADR-026).
model VisaRule {
  id          String          @id @default(uuid(7)) @db.Uuid
  nationality String          @db.Char(2)
  destination String          @db.Char(2)
  purpose     VisaPurpose
  requirement VisaRequirement
  maxStayDays Int?            @map("max_stay_days")
  notes       String?
  verifiedAt  DateTime?       @map("verified_at") @db.Date
  sample      Boolean         @default(false)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([nationality, destination, purpose])
  @@map("visa_rules")
}

/// Visa assistance for a destination: service fee, processing time and document checklist.
model VisaProduct {
  id                String        @id @default(uuid(7)) @db.Uuid
  slug              String        @unique
  status            CatalogStatus @default(draft)
  sample            Boolean       @default(false)
  title             String
  summary           String
  destination       String        @db.Char(2)
  purposes          VisaPurpose[]
  processingDaysMin Int           @map("processing_days_min")
  processingDaysMax Int           @map("processing_days_max")
  /// Service fee per applicant, wire money.
  price             Json
  currency          String        @db.Char(3)
  priceMinor        BigInt        @map("price_minor")
  /// [{ key, label, description, required }].
  checklist         Json
  /// Government fees are paid to the authority; this explains them (amount varies).
  governmentFeeNote String?       @map("government_fee_note")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  applications VisaApplication[]

  @@index([status, destination])
  @@map("visa_products")
}

/// One applicant's application, opened when the assistance booking is confirmed.
model VisaApplication {
  id                String                @id @default(uuid(7)) @db.Uuid
  bookingId         String                @map("booking_id") @db.Uuid
  productId         String                @map("product_id") @db.Uuid
  /// The booking passenger this application is for.
  applicantPosition Int                   @map("applicant_position")
  status            VisaApplicationStatus @default(awaiting_documents)
  purpose           VisaPurpose
  nationality       String                @db.Char(2)
  destination       String                @db.Char(2)
  travelDate        DateTime              @map("travel_date") @db.Date
  submittedAt       DateTime?             @map("submitted_at") @db.Timestamptz(3)
  closedAt          DateTime?             @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking   Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product   VisaProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  documents VisaDocument[]
  events    VisaApplicationEvent[]

  @@unique([bookingId, applicantPosition])
  @@index([status, updatedAt])
  @@map("visa_applications")
}

/// Status changes, officer messages (shown to the customer) and internal notes, append-only.
model VisaApplicationEvent {
  id            String                 @id @default(uuid(7)) @db.Uuid
  applicationId String                 @map("application_id") @db.Uuid
  kind          String
  fromStatus    VisaApplicationStatus? @map("from_status")
  toStatus      VisaApplicationStatus? @map("to_status")
  /// Visible to the customer.
  message       String?
  /// Staff only.
  note          String?
  actorType     BookingActorType       @map("actor_type")
  actorUserId   String?                @map("actor_user_id") @db.Uuid
  occurredAt    DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(3)

  application VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
  @@map("visa_application_events")
}

/// An uploaded document, encrypted at rest with its own key (ADR-026).
model VisaDocument {
  id                String             @id @default(uuid(7)) @db.Uuid
  applicationId     String             @map("application_id") @db.Uuid
  checklistKey      String             @map("checklist_key")
  status            VisaDocumentStatus @default(pending_scan)
  /// Ciphertext location; null once deleted (infected, replaced or past retention).
  storageKey        String?            @map("storage_key")
  contentType       String             @map("content_type")
  sizeBytes         Int                @map("size_bytes")
  /// SHA-256 of the plaintext, hex.
  sha256            String
  /// The document's data key, wrapped by field encryption with `visa-document:{id}`.
  wrappedKey        String             @map("wrapped_key")
  /// Safe file name, encrypted with `visa-document:{id}:name`.
  fileNameEncrypted String             @map("file_name_encrypted")
  uploadedByUserId  String?            @map("uploaded_by_user_id") @db.Uuid
  uploadedAt        DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  scannedAt         DateTime?          @map("scanned_at") @db.Timestamptz(3)
  scanAttempts      Int                @default(0) @map("scan_attempts")
  /// Newer upload for the same checklist item, or officer rejection.
  supersededAt      DateTime?          @map("superseded_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)

  application VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, checklistKey])
  @@index([status, uploadedAt])
  @@map("visa_documents")
}

/// A voucher for a confirmed package, tour or add-on item (ADR-028). Only the code's HMAC is
/// looked up; the code itself is encrypted with `booking-voucher:{id}` for the PDF.
model BookingVoucher {
  id            String    @id @default(uuid(7)) @db.Uuid
  bookingId     String    @map("booking_id") @db.Uuid
  bookingItemId String    @map("booking_item_id") @db.Uuid
  codeHash      String    @unique @map("code_hash")
  codeEncrypted String    @map("code_encrypted")
  redeemedAt    DateTime? @map("redeemed_at") @db.Timestamptz(3)
  redeemedById  String?   @map("redeemed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@unique([bookingItemId])
  @@map("booking_vouchers")
}

// ---------------------------------------------------------------------------
// Phase 9: accounts, Suskii Prime, referrals, notifications (ADR-029 to ADR-032)
// ---------------------------------------------------------------------------

/// Account preferences; absent values fall back to the client's defaults.
model UserPreference {
  userId                 String    @id @map("user_id") @db.Uuid
  locale                 String?
  currency               String?   @db.Char(3)
  homeAirport            String?   @map("home_airport") @db.Char(3)
  /// Marketing consent: when and where it was given (opt-in); null when not given or withdrawn.
  marketingConsentAt     DateTime? @map("marketing_consent_at") @db.Timestamptz(3)
  marketingConsentSource String?   @map("marketing_consent_source")
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum NotificationCategory {
  booking
  payment
  trip_reminder
  price_alert
  prime
  marketing
}

enum NotificationChannel {
  email
  sms
  whatsapp
  push
}

/// A user's choice for one category and channel; missing rows mean the default (ADR-032).
model NotificationPreference {
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}

enum NotificationStatus {
  sent
  skipped
  failed
}

/// Delivery log: what was sent, to whom (by id) and why not. Never bodies or contact values.
model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String?              @map("user_id") @db.Uuid
  bookingId String?              @map("booking_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  template  String
  status    NotificationStatus
  /// Why a message was skipped or failed (preference_off, no_verified_phone, provider_error).
  reason    String?
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookingId])
  @@map("notifications")
}

enum PrimePeriod {
  month
  year
}

/// A Suskii Prime plan (ADR-030). Prices and benefits are data entered by staff.
model PrimePlan {
  id        String        @id @default(uuid(7)) @db.Uuid
  slug      String        @unique
  name      String
  summary   String
  period    PrimePeriod
  /// [{ amountMinor, currency }], one per currency it is sold in.
  prices    Json
  /// { markupShareBps, waivedFeeCodes, prioritySupport }.
  benefits  Json
  status    CatalogStatus @default(draft)
  sample    Boolean       @default(false)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships PrimeMembership[]

  @@map("prime_plans")
}

enum PrimeMembershipStatus {
  active
  cancelled
}

/// One paid membership term (a purchase); a member has a term covering now (ADR-030).
model PrimeMembership {
  id             String                @id @default(uuid(7)) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  planId         String                @map("plan_id") @db.Uuid
  bookingId      String                @unique @map("booking_id") @db.Uuid
  status         PrimeMembershipStatus @default(active)
  startsAt       DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime              @map("ends_at") @db.Timestamptz(3)
  /// The plan's benefits when bought: later plan edits do not change a running term.
  benefits       Json
  reminderSentAt DateTime?             @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan PrimePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, endsAt])
  @@index([status, endsAt])
  @@map("prime_memberships")
}

/// Each account's referral code (ADR-031).
model ReferralCode {
  userId    String   @id @map("user_id") @db.Uuid
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

enum ReferralStatus {
  pending
  qualified
  rewarded
  review
  rejected
}

/// A referred sign-up and its path to a reward (ADR-031). Signals are HMACs, never values.
model Referral {
  id                  String         @id @default(uuid(7)) @db.Uuid
  referrerId          String         @map("referrer_id") @db.Uuid
  refereeId           String         @unique @map("referee_id") @db.Uuid
  code                String
  status              ReferralStatus @default(pending)
  /// Fraud flags that sent it to review or rejected it.
  flags               String[]       @default([])
  /// { email, phone, network, device } HMACs captured at sign-up.
  signals             Json
  qualifyingBookingId String?        @map("qualifying_booking_id") @db.Uuid
  qualifiedAt         DateTime?      @map("qualified_at") @db.Timestamptz(3)
  rewardedAt          DateTime?      @map("rewarded_at") @db.Timestamptz(3)
  reviewedById        String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@index([status])
  @@map("referrals")
}

/// A watched flight route (ADR-032).
model PriceAlert {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  origin            String     @db.Char(3)
  destination       String     @db.Char(3)
  /// Exact departure date, or a month (YYYY-MM) to watch its cheapest date.
  departureDate     DateTime?  @map("departure_date") @db.Date
  departureMonth    String?    @map("departure_month")
  cabinClass        CabinClass @default(economy) @map("cabin_class")
  currency          String     @db.Char(3)
  targetMinor       BigInt?    @map("target_minor")
  lastPriceMinor    BigInt?    @map("last_price_minor")
  lastCheckedAt     DateTime?  @map("last_checked_at") @db.Timestamptz(3)
  lastNotifiedAt    DateTime?  @map("last_notified_at") @db.Timestamptz(3)
  lastNotifiedMinor BigInt?    @map("last_notified_minor")
  active            Boolean    @default(true)
  /// The alert retires after this date (the departure date or the month's last day).
  endsOn            DateTime   @map("ends_on") @db.Date
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active, lastCheckedAt])
  @@map("price_alerts")
}

// ---------------------------------------------------------------------------
// Admin console (phase 10, ADR-033 to ADR-036)
// ---------------------------------------------------------------------------

/// Internal note staff add to a booking. Never shown to travellers; the text is encrypted with
/// the context `booking-note:{id}` because staff may record personal details.
model BookingNote {
  id            String   @id @default(uuid(7)) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  bodyEncrypted String   @map("body_encrypted")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_notes")
}
