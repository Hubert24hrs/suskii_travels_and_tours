// Suskii Travels database schema. Conventions: UUIDv7 ids, snake_case tables and columns,
// timestamptz everywhere (UTC), no floats for money (money arrives in phase 3 as BIGINT minor units).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  disabled
  /// Anonymised on the owner's request (ADR-029); kept as a tombstone for financial records.
  deleted
}

enum RoleKey {
  customer
  super_admin
  operations
  finance
  support
  content_manager
  visa_officer
  /// The data protection officer or Information Officer (ADR-089).
  privacy_officer
  /// Cars (ADR-049): approved drivers and bus operators' boarding agents; not staff.
  driver
  operator_agent
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Lower-cased and trimmed before storage.
  email           String?    @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// E.164, e.g. +2348012345678.
  phone           String?    @unique
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  /// argon2id; null for OTP-only and social-only accounts.
  passwordHash    String?    @map("password_hash")
  displayName     String?    @map("display_name")
  status          UserStatus @default(active)
  /// When the account was anonymised (ADR-029).
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                   UserRole[]               @relation("UserRoles")
  sessions                Session[]
  mfaFactors              MfaFactor[]
  recoveryCodes           MfaRecoveryCode[]
  socialIdentities        SocialIdentity[]
  deviceCredentials       DeviceCredential[]
  verificationTokens      VerificationToken[]
  bookings                Booking[]
  travellers              Traveller[]
  pushTokens              PushToken[]
  preferences             UserPreference?
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  memberships             PrimeMembership[]
  referralCode            ReferralCode?
  referralsMade           Referral[]               @relation("Referrer")
  referredBy              Referral?                @relation("Referee")
  priceAlerts             PriceAlert[]
  operatorMemberships     OperatorMember[]
  driver                  Driver?
  rides                   Ride[]                   @relation("RideRider")
  emergencyContacts       EmergencyContact[]
  partnerClicks           PartnerClick[]
  reviews                 Review[]
  companyMembership       CompanyMember?
  supportConversations    SupportConversation[]    @relation("SupportOwner")
  assignedSupport         SupportConversation[]    @relation("SupportAssignee")
  supportMessages         SupportMessage[]         @relation("SupportStaffAuthor")
  privacyRequests         PrivacyRequest[]

  @@map("users")
}

model Role {
  key         RoleKey          @id
  description String
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  /// e.g. "bookings:read". The catalog lives in @suskii/shared and is synced by the seed.
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       RoleKey    @map("role_key")
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleKey     RoleKey  @map("role_key")
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  grantedById String?  @map("granted_by_id") @db.Uuid
  user        User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleKey], references: [key])

  @@id([userId, roleKey])
  @@map("user_roles")
}

enum AuthMethod {
  password
  otp
  google
  apple
  /// Fingerprint (biometric) sign-in with a device credential (ADR-067).
  device
}

/// One signed-in device. Its refresh tokens form a rotation family.
model Session {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  authMethod    AuthMethod     @map("auth_method")
  userAgent     String?        @map("user_agent")
  /// HMAC of the client IP (never the raw address).
  ipHash        String?        @map("ip_hash")
  /// Set when MFA was completed for this session.
  mfaVerifiedAt DateTime?      @map("mfa_verified_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?        @map("revoked_reason")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  pushTokens    PushToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  /// SHA-256 of the opaque token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the token was exchanged for a new one; presenting it again is reuse.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum MfaFactorType {
  totp
}

model MfaFactor {
  id               String        @id @default(uuid(7)) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  type             MfaFactorType
  /// AES-256-GCM envelope (field encryption); never the plain secret.
  secretCiphertext String        @map("secret_ciphertext")
  confirmedAt      DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step, to reject replays.
  lastUsedStep     BigInt?       @map("last_used_step")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

enum SocialProvider {
  google
  apple
}

model SocialIdentity {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  provider  SocialProvider
  /// The provider's stable subject id (`sub` claim).
  subject   String
  email     String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("social_identities")
}

/// Fingerprint sign-in on one phone (ADR-067): the secret stays in the phone's secure store
/// behind the biometric prompt; only its HMAC is kept here. Revoked when every session of the
/// account is ended (password reset or change, sign-out everywhere, staff actions, incidents).
model DeviceCredential {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// HMAC (`device-credential` purpose) of the id and secret; the secret is never stored.
  secretHash String    @map("secret_hash")
  /// The phone's own description ("Android", "iPhone"), shown under Signed-in devices.
  label      String    @db.VarChar(80)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_credentials")
}

enum VerificationPurpose {
  email_verification
  password_reset
}

model VerificationToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Audit (append-only: UPDATE, DELETE and TRUNCATE are rejected by a trigger)
// ---------------------------------------------------------------------------

enum ActorType {
  user
  system
  anonymous
}

model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType   ActorType @map("actor_type")
  /// No foreign key: audit history must outlive user deletion or anonymisation.
  actorUserId String?   @map("actor_user_id") @db.Uuid
  /// Dotted event name, e.g. "auth.login.succeeded".
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  requestId   String?   @map("request_id")
  ipHash      String?   @map("ip_hash")
  userAgent   String?   @map("user_agent")
  metadata    Json      @default("{}")

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Idempotency (Idempotency-Key header on write endpoints, kept 24 hours)
// ---------------------------------------------------------------------------

enum IdempotencyStatus {
  in_progress
  completed
}

model IdempotencyKey {
  id             String            @id @default(uuid(7)) @db.Uuid
  /// Who owns the key: "user:<id>" or "anon:<ip hash>". Keys never collide across callers.
  scope          String
  key            String
  /// SHA-256 of method, route and canonical body; a different payload under the same key is rejected.
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(in_progress)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Catalog (reference data)
// ---------------------------------------------------------------------------

enum AirportType {
  large_airport
  medium_airport
  small_airport
}

model Country {
  /// ISO 3166-1 alpha-2.
  code      String    @id @db.Char(2)
  name      String
  /// Two-letter continent code (AF, AN, AS, EU, NA, OC, SA).
  continent String    @db.Char(2)
  cities    City[]
  airports  Airport[]

  @@map("countries")
}

model City {
  id          String              @id @default(uuid(7)) @db.Uuid
  name        String
  countryCode String              @map("country_code") @db.Char(2)
  latitude    Float?
  longitude   Float?
  /// IANA time zone, e.g. Africa/Lagos.
  timezone    String?
  /// Accent-folded, lower-case "name country" for trigram autocomplete (set by the seed).
  searchText  String              @default("") @map("search_text")
  country     Country             @relation(fields: [countryCode], references: [code])
  airports    Airport[]
  destination DestinationContent?
  packages    TravelPackage[]
  tours       Tour[]

  @@unique([countryCode, name])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "cities_search_text_trgm_idx")
  @@map("cities")
}

model Airport {
  iataCode         String      @id @map("iata_code") @db.Char(3)
  icaoCode         String?     @map("icao_code") @db.VarChar(4)
  name             String
  type             AirportType
  municipality     String?
  cityId           String?     @map("city_id") @db.Uuid
  countryCode      String      @map("country_code") @db.Char(2)
  latitude         Float
  longitude        Float
  /// IANA time zone; flight times are stored in UTC plus this zone.
  timezone         String
  scheduledService Boolean     @default(true) @map("scheduled_service")
  /// Accent-folded, lower-case "code name municipality country" for trigram autocomplete.
  searchText       String      @default("") @map("search_text")
  city             City?       @relation(fields: [cityId], references: [id])
  country          Country     @relation(fields: [countryCode], references: [code])
  dealOrigins      DealRoute[] @relation("DealRouteOrigin")
  dealDestinations DealRoute[] @relation("DealRouteDestination")

  @@index([countryCode])
  @@index([cityId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "airports_search_text_trgm_idx")
  @@map("airports")
}

/// Populated from the flight supplier's reference data (phase 3, ADR-006).
model Airline {
  id          String   @id @default(uuid(7)) @db.Uuid
  iataCode    String   @unique @map("iata_code") @db.VarChar(3)
  icaoCode    String?  @map("icao_code") @db.VarChar(4)
  name        String
  countryCode String?  @map("country_code") @db.Char(2)
  logoUrl     String?  @map("logo_url")
  active      Boolean  @default(true)
  /// Where the record came from, e.g. "duffel".
  source      String
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("airlines")
}

// ---------------------------------------------------------------------------
// Pricing (rules are managed in the admin console, phase 10; none are seeded)
// ---------------------------------------------------------------------------

enum Vertical {
  flights
  hotels
  packages
  tours
  visa
  travel_addons
  /// Suskii Prime membership purchases (ADR-030).
  prime
  /// Cars (ADR-049): interstate bus tickets, intrastate rides and car rental.
  buses
  rides
  rentals
}

enum CabinClass {
  economy
  premium_economy
  business
  first
}

enum SalesChannel {
  web
  mobile
}

enum UserTier {
  guest
  member
  prime
}

enum AdjustmentType {
  percentage
  fixed
}

/// What a tax rule is charged on (ADR-072).
enum TaxBasis {
  /// Suskii's markup and fees, less discounts: bookings sold as agent.
  margin
  /// Fare and fees, less discounts: products sold as principal.
  full
}

enum FeeBasis {
  per_booking
  per_passenger
}

/// Hidden margin on the supplier fare. The first active rule that matches (lowest priority
/// number) applies; rules never stack. Null conditions match anything.
model MarkupRule {
  id                 String         @id @default(uuid(7)) @db.Uuid
  name               String
  vertical           Vertical
  priority           Int            @default(100)
  active             Boolean        @default(true)
  channel            SalesChannel?
  userTier           UserTier?      @map("user_tier")
  supplier           String?
  originCode         String?        @map("origin_code") @db.VarChar(3)
  destinationCode    String?        @map("destination_code") @db.VarChar(3)
  originCountry      String?        @map("origin_country") @db.Char(2)
  destinationCountry String?        @map("destination_country") @db.Char(2)
  carrierCode        String?        @map("carrier_code") @db.VarChar(3)
  cabinClass         CabinClass?    @map("cabin_class")
  type               AdjustmentType
  /// Basis points for percentages (250 = 2.5%), minor units of `currency` for fixed amounts.
  value              BigInt
  /// Currency of a fixed value and of the caps.
  currency           String?        @db.Char(3)
  minAmountMinor     BigInt?        @map("min_amount_minor")
  maxAmountMinor     BigInt?        @map("max_amount_minor")
  validFrom          DateTime?      @map("valid_from") @db.Timestamptz(3)
  validTo            DateTime?      @map("valid_to") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([vertical, active, priority])
  @@map("markup_rules")
}

/// Customer-visible fees (e.g. service fee). Every active matching rule applies.
model FeeRule {
  id             String         @id @default(uuid(7)) @db.Uuid
  /// Stable machine code, e.g. "service_fee".
  code           String
  /// Customer-facing label.
  label          String
  vertical       Vertical
  active         Boolean        @default(true)
  sortOrder      Int            @default(0) @map("sort_order")
  channel        SalesChannel?
  userTier       UserTier?      @map("user_tier")
  type           AdjustmentType
  value          BigInt
  currency       String?        @db.Char(3)
  basis          FeeBasis       @default(per_booking)
  minAmountMinor BigInt?        @map("min_amount_minor")
  maxAmountMinor BigInt?        @map("max_amount_minor")
  validFrom      DateTime?      @map("valid_from") @db.Timestamptz(3)
  validTo        DateTime?      @map("valid_to") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([vertical, active])
  @@map("fee_rules")
}

/// Tax on Suskii's own service, per selling country (ADR-072). Edited only from the admin API.
model TaxRule {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// ISO 3166-1 alpha-2 code of the selling entity's country.
  country            String    @db.Char(2)
  /// Stable machine code, e.g. "vat".
  code               String
  /// Customer-facing label, e.g. "VAT".
  label              String
  /// Rate in basis points (750 = 7.5%).
  rateBps            Int       @map("rate_bps")
  basis              TaxBasis
  /// Null applies the rule to every vertical.
  vertical           Vertical?
  active             Boolean   @default(true)
  /// The seller's tax registration number, printed on receipts.
  registrationNumber String?   @map("registration_number")
  validFrom          DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo            DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([country, active])
  @@map("tax_rules")
}

model PromoCode {
  id                    String            @id @default(uuid(7)) @db.Uuid
  /// Stored upper-case; matched case-insensitively.
  code                  String            @unique
  description           String?
  type                  AdjustmentType
  /// Basis points for percentages, minor units of `currency` for fixed discounts.
  value                 BigInt
  /// Currency of a fixed value, the cap and the minimum spend.
  currency              String?           @db.Char(3)
  maxDiscountMinor      BigInt?           @map("max_discount_minor")
  minSpendMinor         BigInt?           @map("min_spend_minor")
  /// Empty means every vertical.
  verticals             Vertical[]
  validFrom             DateTime?         @map("valid_from") @db.Timestamptz(3)
  validTo               DateTime?         @map("valid_to") @db.Timestamptz(3)
  maxRedemptions        Int?              @map("max_redemptions")
  maxRedemptionsPerUser Int?              @map("max_redemptions_per_user")
  requiresAccount       Boolean           @default(false) @map("requires_account")
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  redemptions           PromoRedemption[]

  @@map("promo_codes")
}

/// Written when a booking is paid (phase 6); counted for usage limits.
model PromoRedemption {
  id          String    @id @default(uuid(7)) @db.Uuid
  promoCodeId String    @map("promo_code_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  bookingId   String?   @map("booking_id") @db.Uuid
  amountMinor BigInt    @map("amount_minor")
  currency    String    @db.Char(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  @@index([promoCodeId, userId])
  @@map("promo_redemptions")
}

// ---------------------------------------------------------------------------
// Search and offers
// ---------------------------------------------------------------------------

/// A supplier offer re-priced for checkout. Bookings (phase 5) are created from these.
model Offer {
  id                  String             @id @default(uuid(7)) @db.Uuid
  vertical            Vertical
  supplier            String
  supplierOfferId     String             @map("supplier_offer_id")
  /// Normalised offer in our domain shape (never raw vendor JSON).
  payload             Json
  supplierTotalMinor  BigInt             @map("supplier_total_minor")
  supplierCurrency    String             @map("supplier_currency") @db.Char(3)
  /// Customer price breakdown at quote time.
  price               Json
  totalMinor          BigInt             @map("total_minor")
  currency            String             @db.Char(3)
  searchId            String?            @map("search_id")
  userId              String?            @map("user_id") @db.Uuid
  expiresAt           DateTime           @map("expires_at") @db.Timestamptz(3)
  /// The metasearch landing that quoted it (ADR-081); bookings copy it.
  metasearchLandingId String?            @map("metasearch_landing_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  bookingItems        BookingItem[]
  metasearchLanding   MetasearchLanding? @relation(fields: [metasearchLandingId], references: [id], onDelete: SetNull)

  @@index([supplier, supplierOfferId])
  @@index([expiresAt])
  @@map("offers")
}

/// Anonymised search analytics: no user, session or IP; only what was searched and how it went.
model SearchLog {
  id               String        @id @default(uuid(7)) @db.Uuid
  occurredAt       DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  vertical         Vertical
  origin           String?       @db.VarChar(3)
  destination      String?       @db.VarChar(64)
  departureDate    DateTime?     @map("departure_date") @db.Date
  returnDate       DateTime?     @map("return_date") @db.Date
  sliceCount       Int?          @map("slice_count")
  travellers       Int
  cabinClass       CabinClass?   @map("cabin_class")
  channel          SalesChannel?
  cacheHit         Boolean       @map("cache_hit")
  partial          Boolean
  resultCount      Int           @map("result_count")
  durationMs       Int           @map("duration_ms")
  supplierOutcomes Json          @map("supplier_outcomes")

  @@index([vertical, occurredAt])
  @@index([origin, destination])
  @@map("search_logs")
}

/// A visitor's cookie choice (ADR-042), recorded before any optional category is enabled. The
/// consent id is random and lives only in the visitor's consent cookie: no account, IP or browser.
model CookieConsent {
  id            String   @id @default(uuid(7)) @db.Uuid
  consentId     String   @map("consent_id") @db.Uuid
  policyVersion Int      @map("policy_version")
  analytics     Boolean
  marketing     Boolean
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([consentId])
  @@index([createdAt])
  @@map("cookie_consents")
}

// ---------------------------------------------------------------------------
// CMS
// ---------------------------------------------------------------------------

/// Marketing trust claims. Only rows with verified = true may ever be rendered (brand guardrails).
model TrustSignal {
  key         String    @id
  label       String
  value       String?
  verified    Boolean   @default(false)
  evidenceUrl String?   @map("evidence_url")
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)
  verifiedBy  String?   @map("verified_by") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("trust_signals")
}

model CmsBlock {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String
  locale      String    @default("en-NG")
  content     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([key, locale])
  @@map("cms_blocks")
}

model Faq {
  id          String    @id @default(uuid(7)) @db.Uuid
  locale      String    @default("en-NG")
  question    String
  answer      String
  sortOrder   Int       @default(0) @map("sort_order")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([locale, sortOrder])
  @@map("faqs")
}

// ---------------------------------------------------------------------------
// Deals and hotel destinations (phase 4, ADR-011)
// ---------------------------------------------------------------------------

/// Popular routes the deals worker keeps fresh. Configuration, managed in the admin console.
model DealRoute {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// URL slug of the SEO route page, e.g. lagos-to-london.
  slug            String         @unique
  originCode      String         @map("origin_code") @db.Char(3)
  destinationCode String         @map("destination_code") @db.Char(3)
  cabinClass      CabinClass     @default(economy) @map("cabin_class")
  /// Nights between the outbound and return flights.
  stayNights      Int            @default(7) @map("stay_nights")
  active          Boolean        @default(true)
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  origin          Airport        @relation("DealRouteOrigin", fields: [originCode], references: [iataCode])
  destination     Airport        @relation("DealRouteDestination", fields: [destinationCode], references: [iataCode])
  snapshots       DealSnapshot[]
  fares           RouteFare[]

  @@unique([originCode, destinationCode, cabinClass])
  @@index([active, sortOrder])
  @@map("deal_routes")
}

/// Fare history for route facts (ADR-080): the cheapest fare found per route, observation day
/// (UTC) and departure date. Supplier cost, priced only at read time; no personal data.
model RouteFare {
  id              String    @id @default(uuid(7)) @db.Uuid
  routeId         String    @map("route_id") @db.Uuid
  observedOn      DateTime  @map("observed_on") @db.Date
  departureDate   DateTime  @map("departure_date") @db.Date
  returnDate      DateTime? @map("return_date") @db.Date
  supplier        String
  carrierCode     String    @map("carrier_code") @db.VarChar(3)
  carrierName     String    @map("carrier_name")
  /// Outbound slice.
  stops           Int
  durationMinutes Int       @map("duration_minutes")
  baseMinor       BigInt    @map("base_minor")
  taxesMinor      BigInt    @map("taxes_minor")
  currency        String    @db.Char(3)
  /// Base plus taxes in US cents when found: compares fares quoted in different currencies.
  usdMinor        BigInt    @map("usd_minor")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  route           DealRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, observedOn, departureDate])
  @@index([observedOn])
  @@map("route_fares")
}

/// Cheapest fare found by one refresh. Supplier price plus the context markup rules need; the
/// customer price is computed on read (current rules, display currency, channel).
model DealSnapshot {
  id                 String    @id @default(uuid(7)) @db.Uuid
  routeId            String    @map("route_id") @db.Uuid
  supplier           String
  departureDate      DateTime  @map("departure_date") @db.Date
  returnDate         DateTime? @map("return_date") @db.Date
  carrierCode        String    @map("carrier_code") @db.VarChar(3)
  carrierName        String    @map("carrier_name")
  /// Outbound slice.
  stops              Int
  durationMinutes    Int       @map("duration_minutes")
  baseMinor          BigInt    @map("base_minor")
  taxesMinor         BigInt    @map("taxes_minor")
  currency           String    @db.Char(3)
  originCountry      String    @map("origin_country") @db.Char(2)
  destinationCountry String    @map("destination_country") @db.Char(2)
  fetchedAt          DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(3)
  route              DealRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, fetchedAt(sort: Desc)])
  @@index([fetchedAt])
  @@map("deal_snapshots")
}

/// CMS destination content (spec entity DestinationContent). Featured ones appear on the homepage.
model DestinationContent {
  id             String                     @id @default(uuid(7)) @db.Uuid
  cityId         String                     @unique @map("city_id") @db.Uuid
  /// URL slug of the SEO city page, e.g. cape-town.
  slug           String                     @unique
  featured       Boolean                    @default(false)
  sortOrder      Int                        @default(0) @map("sort_order")
  /// Licensed photo URL; the web shows an illustration while it is empty.
  imageUrl       String?                    @map("image_url")
  publishedAt    DateTime?                  @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  city           City                       @relation(fields: [cityId], references: [id])
  hotelSnapshots DestinationHotelSnapshot[]

  @@index([featured, sortOrder])
  @@map("destination_contents")
}

/// Hotel availability and the cheapest rate found by one refresh (supplier price for the stay).
model DestinationHotelSnapshot {
  id            String             @id @default(uuid(7)) @db.Uuid
  destinationId String             @map("destination_id") @db.Uuid
  supplier      String
  checkIn       DateTime           @map("check_in") @db.Date
  checkOut      DateTime           @map("check_out") @db.Date
  hotelCount    Int                @map("hotel_count")
  baseMinor     BigInt             @map("base_minor")
  taxesMinor    BigInt             @map("taxes_minor")
  currency      String             @db.Char(3)
  countryCode   String             @map("country_code") @db.Char(2)
  fetchedAt     DateTime           @default(now()) @map("fetched_at") @db.Timestamptz(3)
  destination   DestinationContent @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, fetchedAt(sort: Desc)])
  @@index([fetchedAt])
  @@map("destination_hotel_snapshots")
}

// ---------------------------------------------------------------------------
// Newsletter (phase 4, ADR-012)
// ---------------------------------------------------------------------------

enum NewsletterStatus {
  pending
  confirmed
  unsubscribed
}

enum WhatsappOptInStatus {
  pending_verification
  verified
}

/// Deal-alert subscription with a provable consent record and double opt-in.
model NewsletterSubscription {
  id                    String               @id @default(uuid(7)) @db.Uuid
  /// Lower-cased and trimmed before storage.
  email                 String               @unique
  status                NewsletterStatus     @default(pending)
  locale                String               @default("en-NG")
  /// E.164. Stored only with an explicit opt-in; nothing is sent until it is verified.
  whatsappPhone         String?              @map("whatsapp_phone")
  whatsappStatus        WhatsappOptInStatus? @map("whatsapp_status")
  consentVersion        String               @map("consent_version")
  consentedAt           DateTime             @map("consented_at") @db.Timestamptz(3)
  /// Keyed hash of the IP the consent came from (proof without keeping the address).
  consentIpHash         String?              @map("consent_ip_hash")
  source                String               @default("homepage")
  /// SHA-256 of the confirmation token; the token itself only exists in the email.
  confirmTokenHash      String?              @unique @map("confirm_token_hash")
  confirmTokenExpiresAt DateTime?            @map("confirm_token_expires_at") @db.Timestamptz(3)
  confirmationSentAt    DateTime?            @map("confirmation_sent_at") @db.Timestamptz(3)
  confirmedAt           DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  unsubscribedAt        DateTime?            @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("newsletter_subscriptions")
}

// ---------------------------------------------------------------------------
// Bookings, payments and documents (phase 5, ADR-014 and ADR-015)
// ---------------------------------------------------------------------------

enum BookingStatus {
  DRAFT
  PRICED
  HELD
  AWAITING_PAYMENT
  PARTIALLY_PAID
  PAID
  TICKETING
  CONFIRMED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  EXPIRED
}

enum BookingItemType {
  flight
  hotel
  package
  tour
  visa
  addon
  membership
  /// Cars (ADR-049).
  bus
  ride
  rental
}

/// Where a booking item's seats on a departure stand (ADR-025).
enum SeatState {
  reserved
  sold
  released
}

enum PassengerType {
  adult
  child
  infant
}

enum BookingActorType {
  customer
  system
  webhook
  staff
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
  expired
}

enum BookingDocumentType {
  e_ticket
  hotel_voucher
  package_voucher
  tour_voucher
  addon_voucher
  visa_confirmation
  /// Bus boarding passes, one page per seat (ADR-050).
  bus_ticket
}

/// One purchase: a flight or a hotel stay now, several items later (packages, add-ons).
model Booking {
  id                   String                @id @default(uuid(7)) @db.Uuid
  /// Short public reference: 6 characters without look-alike letters.
  reference            String                @unique
  status               BookingStatus         @default(DRAFT)
  vertical             Vertical
  userId               String?               @map("user_id") @db.Uuid
  /// HMAC of the guest access token (ADR-015); null for account bookings.
  accessTokenHash      String?               @unique @map("access_token_hash")
  /// JSON { email, phone } encrypted with the context `booking:{id}:contact`.
  contactEncrypted     String                @map("contact_encrypted")
  /// HMAC of the contact email, for lookup without decrypting.
  contactEmailHash     String                @map("contact_email_hash")
  currency             String                @db.Char(3)
  totalMinor           BigInt                @map("total_minor")
  /// Customer price breakdown at the agreed price (fare, extras, discount, total).
  price                Json
  /// Re-priced breakdown waiting for the traveller's consent.
  pendingPrice         Json?                 @map("pending_price")
  promoCodeId          String?               @map("promo_code_id") @db.Uuid
  channel              SalesChannel
  locale               String                @default("en-NG")
  termsVersion         String                @map("terms_version")
  termsAcceptedAt      DateTime              @map("terms_accepted_at") @db.Timestamptz(3)
  /// Unpaid bookings expire at this instant.
  paymentDeadline      DateTime?             @map("payment_deadline") @db.Timestamptz(3)
  ticketingAttempts    Int                   @default(0) @map("ticketing_attempts")
  nextTicketingAt      DateTime?             @map("next_ticketing_at") @db.Timestamptz(3)
  confirmedAt          DateTime?             @map("confirmed_at") @db.Timestamptz(3)
  /// The booking an add-on belongs to (ADR-027); add-ons are their own bookings.
  linkedBookingId      String?               @map("linked_booking_id") @db.Uuid
  /// Set once the check-in reminder went out (ADR-032).
  checkinRemindedAt    DateTime?             @map("checkin_reminded_at") @db.Timestamptz(3)
  /// When to invite a review: the day after the first reviewable item ends (ADR-077).
  reviewInviteAt       DateTime?             @map("review_invite_at") @db.Timestamptz(3)
  /// Set once the review invitation was handled (sent, or nothing to review).
  reviewInvitedAt      DateTime?             @map("review_invited_at") @db.Timestamptz(3)
  /// The company this trip was booked for (ADR-078); the booker is `user_id`.
  companyId            String?               @map("company_id") @db.Uuid
  /// What the company's travel policy found on the trip (codes from `POLICY_FINDINGS`).
  policyFindings       String[]              @default([]) @map("policy_findings")
  approvalStatus       BookingApprovalStatus @default(not_required) @map("approval_status")
  approvalDecidedById  String?               @map("approval_decided_by_id") @db.Uuid
  approvalDecidedAt    DateTime?             @map("approval_decided_at") @db.Timestamptz(3)
  /// Code from `APPROVAL_REJECT_REASONS` when an approver said no.
  approvalRejectReason String?               @map("approval_reject_reason")
  /// The metasearch landing the booking came through (ADR-081), copied from its quote.
  metasearchLandingId  String?               @map("metasearch_landing_id") @db.Uuid
  /// Contact details and passports wiped after account deletion (ADR-029).
  redactedAt           DateTime?             @map("redacted_at") @db.Timestamptz(3)
  /// Set when the retention sweep cleared the last personal data of a closed booking (ADR-039).
  anonymisedAt         DateTime?             @map("anonymised_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkedBooking        Booking?               @relation("LinkedAddons", fields: [linkedBookingId], references: [id], onDelete: SetNull)
  addons               Booking[]              @relation("LinkedAddons")
  vouchers             BookingVoucher[]
  visaApplications     VisaApplication[]
  items                BookingItem[]
  busTickets           BusTicket[]
  ride                 Ride?
  passengers           BookingPassenger[]
  history              BookingStatusHistory[]
  payments             Payment[]
  documents            BookingDocument[]
  paymentPlan          PaymentPlan?
  refunds              Refund[]
  accessLinks          BookingAccessLink[]
  pushTokens           PushToken[]
  notes                BookingNote[]
  riskReviews          PaymentRiskReview[]
  scheduleChanges      FlightScheduleChange[]
  partnerClicks        PartnerClick[]
  reviews              Review[]
  supportConversations SupportConversation[]
  adConversion         AdConversion?
  company              Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  metasearchLanding    MetasearchLanding?     @relation(fields: [metasearchLandingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  /// Admin booking search and the dashboard filter by creation date (ADR-036).
  @@index([createdAt])
  @@index([status, paymentDeadline])
  @@index([status, nextTicketingAt])
  @@index([contactEmailHash])
  @@index([linkedBookingId])
  @@index([status, updatedAt])
  /// The review invitation sweep (ADR-077).
  @@index([status, reviewInviteAt])
  /// Company reports and approvals (ADR-078).
  @@index([companyId, createdAt])
  /// Metasearch partner reports (ADR-081).
  @@index([metasearchLandingId])
  @@map("bookings")
}

model BookingItem {
  id                   String          @id @default(uuid(7)) @db.Uuid
  bookingId            String          @map("booking_id") @db.Uuid
  type                 BookingItemType
  offerId              String          @map("offer_id") @db.Uuid
  supplier             String
  supplierOfferId      String          @map("supplier_offer_id")
  /// Offer snapshot in our domain shape, as priced for this booking.
  payload              Json
  /// Extras chosen at checkout: [{ serviceId, passengerIndex, quantity }].
  services             Json            @default("[]")
  totalMinor           BigInt          @map("total_minor")
  currency             String          @db.Char(3)
  /// Airline PNR or hotel confirmation number, once booked (or held) with the supplier.
  supplierReference    String?         @map("supplier_reference")
  /// Supplier order id of a held booking (Duffel `pay_later` order), paid at ticketing.
  supplierOrderId      String?         @map("supplier_order_id")
  /// The supplier releases the held space at this instant.
  heldUntil            DateTime?       @map("held_until") @db.Timestamptz(3)
  /// The supplier guarantees the held price until this instant.
  priceGuaranteedUntil DateTime?       @map("price_guaranteed_until") @db.Timestamptz(3)
  /// [{ passengerIndex, number }] for flights.
  ticketNumbers        Json?           @map("ticket_numbers")
  bookedAt             DateTime?       @map("booked_at") @db.Timestamptz(3)
  /// Package or tour departure whose seats this item holds (ADR-025).
  packageDepartureId   String?         @map("package_departure_id") @db.Uuid
  tourDepartureId      String?         @map("tour_departure_id") @db.Uuid
  seats                Int?
  seatState            SeatState?      @map("seat_state")
  /// A ticketed flight is next asked for airline changes at this instant; null once it has
  /// departed or its supplier does not report changes (ADR-065).
  nextChangeCheckAt    DateTime?       @map("next_change_check_at") @db.Timestamptz(3)
  /// The traveller's IP from checkout, encrypted (`booking-item:{id}:customer-ip`), for a supplier
  /// that requires it on its booking call (Expedia, ADR-086); cleared once booked or after 7 days.
  customerIpEncrypted  String?         @map("customer_ip_encrypted")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking          Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offer            Offer                  @relation(fields: [offerId], references: [id], onDelete: Restrict)
  packageDeparture PackageDeparture?      @relation(fields: [packageDepartureId], references: [id], onDelete: Restrict)
  tourDeparture    TourDeparture?         @relation(fields: [tourDepartureId], references: [id], onDelete: Restrict)
  vouchers         BookingVoucher[]
  busSeats         BusSeatAssignment[]
  busTickets       BusTicket[]
  ride             Ride?
  rental           RentalReservation?
  scheduleChanges  FlightScheduleChange[]
  review           Review?

  @@index([bookingId])
  @@index([packageDepartureId])
  @@index([tourDepartureId])
  @@index([nextChangeCheckAt])
  @@map("booking_items")
}

/// open: waiting for the traveller (or support); the others say how it was resolved.
enum ScheduleChangeStatus {
  open
  accepted
  cancelled
  changed
}

/// A change the airline made to a ticketed flight: new times, flights or routing (ADR-065).
model FlightScheduleChange {
  id                     String               @id @default(uuid(7)) @db.Uuid
  bookingId              String               @map("booking_id") @db.Uuid
  bookingItemId          String               @map("booking_item_id") @db.Uuid
  supplier               String
  supplierChangeId       String               @map("supplier_change_id")
  /// The changed slices as booked and the slices replacing them, in our domain shape.
  removed                Json
  added                  Json
  /// Whether the traveller can accept it online; otherwise support resolves it.
  acceptable             Boolean
  /// Cancelled flight, other airport, more connections or a large time move: the traveller may
  /// take a full refund instead (ADR-073). Decided when the change is found.
  significant            Boolean              @default(false)
  /// The airline would not refund what we paid it, so support took the refund offer over.
  refundOfferWithdrawnAt DateTime?            @map("refund_offer_withdrawn_at") @db.Timestamptz(3)
  status                 ScheduleChangeStatus @default(open)
  /// When the supplier recorded the change.
  changedAt              DateTime             @map("changed_at") @db.Timestamptz(3)
  detectedAt             DateTime             @default(now()) @map("detected_at") @db.Timestamptz(3)
  resolvedAt             DateTime?            @map("resolved_at") @db.Timestamptz(3)

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@unique([supplier, supplierChangeId])
  @@index([bookingId, detectedAt])
  @@index([bookingItemId])
  @@map("flight_schedule_changes")
}

/// A flight passenger or a hotel room's lead guest (then only names and `roomIndex`).
model BookingPassenger {
  id                String        @id @default(uuid(7)) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  position          Int
  type              PassengerType
  title             String?
  gender            String?
  /// Passport (machine-readable) form, e.g. ADEBAYO CHIOMA.
  givenNames        String        @map("given_names")
  surname           String
  dateOfBirth       DateTime?     @map("date_of_birth") @db.Date
  nationality       String?       @db.Char(2)
  /// Encrypted with `booking-passenger:{id}:passport`.
  passportEncrypted String?       @map("passport_encrypted")
  /// Last three characters, for display.
  documentHint      String?       @map("document_hint")
  issuingCountry    String?       @map("issuing_country") @db.Char(2)
  documentExpiry    DateTime?     @map("document_expiry") @db.Date
  travellerId       String?       @map("traveller_id") @db.Uuid
  roomIndex         Int?          @map("room_index")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, position])
  @@map("booking_passengers")
}

/// Every status change, append-only (also mirrored to the audit log).
model BookingStatusHistory {
  id          String           @id @default(uuid(7)) @db.Uuid
  bookingId   String           @map("booking_id") @db.Uuid
  fromStatus  BookingStatus?   @map("from_status")
  toStatus    BookingStatus    @map("to_status")
  event       String
  reason      String?
  actorType   BookingActorType @map("actor_type")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  occurredAt  DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, occurredAt])
  @@map("booking_status_history")
}

/// Saved passengers of an account (at most 20 per user).
model Traveller {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  title             String
  gender            String
  givenNames        String    @map("given_names")
  surname           String
  dateOfBirth       DateTime  @map("date_of_birth") @db.Date
  nationality       String    @db.Char(2)
  /// Encrypted with `traveller:{id}:passport`.
  passportEncrypted String?   @map("passport_encrypted")
  documentHint      String?   @map("document_hint")
  issuingCountry    String?   @map("issuing_country") @db.Char(2)
  documentExpiry    DateTime? @map("document_expiry") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("travellers")
}

enum PaymentKind {
  checkout
  wallet
}

model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  kind                  PaymentKind   @default(checkout)
  provider              String
  providerReference     String        @unique @map("provider_reference")
  /// Provider's own id for the charge (refunds and verification use it).
  providerTransactionId String?       @map("provider_transaction_id")
  status                PaymentStatus @default(pending)
  amountMinor           BigInt        @map("amount_minor")
  currency              String        @db.Char(3)
  /// Hosted checkout page; null for wallet payments.
  checkoutUrl           String?       @map("checkout_url")
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz(3)
  succeededAt           DateTime?     @map("succeeded_at") @db.Timestamptz(3)
  failureReason         String?       @map("failure_reason")
  /// Channel reported by the provider (card, bank_transfer, ussd...). Never card details.
  method                String?
  /// The installment this payment pays, for payment plans.
  installmentId         String?       @map("installment_id") @db.Uuid
  /// Money received that the booking could not take (duplicate, mismatch, too late); refunded automatically.
  requiresRefund        Boolean       @default(false) @map("requires_refund")
  /// Last time the worker asked the provider about this pending payment.
  reconciledAt          DateTime?     @map("reconciled_at") @db.Timestamptz(3)
  /// Risk signals (ADR-040): HMAC of the payer's IP and the country the edge reported for it.
  ipHash                String?       @map("ip_hash")
  ipCountry             String?       @map("ip_country") @db.Char(2)
  /// Issuing country of the card and an HMAC of the provider's card identifier, when reported.
  cardCountry           String?       @map("card_country") @db.Char(2)
  cardFingerprintHash   String?       @map("card_fingerprint_hash")
  /// When the reconciliation sweep last compared it with the ledger and the provider.
  ledgerCheckedAt       DateTime?     @map("ledger_checked_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  installment Installment?        @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  refunds     Refund[]
  riskReviews PaymentRiskReview[]

  @@index([bookingId])
  @@index([status, expiresAt])
  @@index([ipHash, createdAt])
  @@index([status, ledgerCheckedAt])
  @@map("payments")
}

enum PaymentRiskStatus {
  open
  approved
  rejected
}

/// A captured payment whose risk score held fulfilment until staff decide (ADR-040).
model PaymentRiskReview {
  id          String            @id @default(uuid(7)) @db.Uuid
  bookingId   String            @map("booking_id") @db.Uuid
  paymentId   String            @map("payment_id") @db.Uuid
  score       Int
  /// Signal codes that fired (velocity_account, card_country_mismatch, ...); no personal values.
  signals     String[]
  status      PaymentRiskStatus @default(open)
  /// Staff decision: reason code only (free text could carry personal data).
  reason      String?
  decidedById String?           @map("decided_by_id") @db.Uuid
  decidedAt   DateTime?         @map("decided_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("payment_risk_reviews")
}

/// Provider webhooks, deduplicated by the provider's event id. Normalised fields only, never card data.
model WebhookEvent {
  id                String    @id @default(uuid(7)) @db.Uuid
  provider          String
  eventId           String    @map("event_id")
  type              String
  providerReference String?   @map("provider_reference")
  payload           Json
  outcome           String?
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model BookingDocument {
  id          String              @id @default(uuid(7)) @db.Uuid
  bookingId   String              @map("booking_id") @db.Uuid
  type        BookingDocumentType
  storageKey  String              @map("storage_key")
  fileName    String              @map("file_name")
  contentType String              @map("content_type")
  sizeBytes   Int                 @map("size_bytes")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@map("booking_documents")
}

// ---------------------------------------------------------------------------
// Ledger, payment plans, refunds and access links (phase 6, ADR-016 to ADR-019)
// ---------------------------------------------------------------------------

enum LedgerAccountType {
  asset
  liability
  income
  expense
}

enum LedgerDirection {
  debit
  credit
}

/// A ledger account (ADR-017). The balance is maintained by a trigger on `ledger_entries`, in the
/// account's normal direction, and can only go negative when `allowNegative` is set.
model LedgerAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  /// e.g. `booking:{id}:NGN`, `wallet:{userId}:NGN`, `psp:paystack:NGN`.
  code          String            @unique
  type          LedgerAccountType
  currency      String            @db.Char(3)
  allowNegative Boolean           @default(false) @map("allow_negative")
  balanceMinor  BigInt            @default(0) @map("balance_minor")
  userId        String?           @map("user_id") @db.Uuid
  bookingId     String?           @map("booking_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([userId])
  @@index([bookingId])
  @@map("ledger_accounts")
}

/// One balanced money movement, posted once per idempotency key. Append-only.
model LedgerTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  kind           String
  bookingId      String?  @map("booking_id") @db.Uuid
  paymentId      String?  @map("payment_id") @db.Uuid
  refundId       String?  @map("refund_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([bookingId])
  @@index([paymentId])
  /// Dashboard money figures sum entries by transaction kind and period (ADR-036).
  @@index([kind, createdAt])
  @@map("ledger_transactions")
}

/// Append-only. Debits equal credits per transaction and currency (checked at commit).
model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  direction     LedgerDirection
  amountMinor   BigInt          @map("amount_minor")
  currency      String          @db.Char(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

enum PaymentPlanKind {
  hold
  installments
}

enum PaymentPlanStatus {
  active
  completed
  defaulted
  cancelled
  expired
}

enum InstallmentStatus {
  pending
  paid
  cancelled
}

/// Reserve now and pay later, or a deposit plus installments, on a held booking (ADR-018).
model PaymentPlan {
  id            String            @id @default(uuid(7)) @db.Uuid
  bookingId     String            @unique @map("booking_id") @db.Uuid
  kind          PaymentPlanKind
  status        PaymentPlanStatus @default(active)
  currency      String            @db.Char(3)
  /// Everything the traveller pays over the plan, fee included.
  totalMinor    BigInt            @map("total_minor")
  feeMinor      BigInt            @default(0) @map("fee_minor")
  graceHours    Int               @map("grace_hours")
  /// Policy fee kept on default, in basis points of the amount paid.
  defaultFeeBps Int               @map("default_fee_bps")
  /// Our deadline for full payment (the supplier's minus a safety margin).
  deadline      DateTime          @db.Timestamptz(3)
  closedAt      DateTime?         @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([status, deadline])
  @@map("payment_plans")
}

model Installment {
  id               String            @id @default(uuid(7)) @db.Uuid
  planId           String            @map("plan_id") @db.Uuid
  /// 0 is the deposit (or the whole amount of a hold).
  sequence         Int
  dueAt            DateTime          @map("due_at") @db.Timestamptz(3)
  amountMinor      BigInt            @map("amount_minor")
  currency         String            @db.Char(3)
  status           InstallmentStatus @default(pending)
  paidAt           DateTime?         @map("paid_at") @db.Timestamptz(3)
  reminder3dSentAt DateTime?         @map("reminder_3d_sent_at") @db.Timestamptz(3)
  reminder1dSentAt DateTime?         @map("reminder_1d_sent_at") @db.Timestamptz(3)

  plan     PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([planId, sequence])
  @@index([status, dueAt])
  @@map("installments")
}

enum RefundStatus {
  pending_approval
  approved
  processing
  succeeded
  failed
  rejected
  needs_review
}

enum RefundDestination {
  original
  wallet
}

enum RefundReason {
  duplicate_payment
  amount_mismatch
  late_payment
  ticketing_failed
  installment_default
  customer_cancellation
  goodwill
  supplier_cancellation
  risk_rejected
  /// A rental deposit coming back after the return (ADR-051).
  deposit_release
  other
}

/// Money going back for one payment (ADR-019).
model Refund {
  id                String            @id @default(uuid(7)) @db.Uuid
  bookingId         String            @map("booking_id") @db.Uuid
  paymentId         String            @map("payment_id") @db.Uuid
  provider          String
  amountMinor       BigInt            @map("amount_minor")
  currency          String            @db.Char(3)
  destination       RefundDestination
  reason            RefundReason
  status            RefundStatus
  /// Computed by the system (no discretion) rather than requested by staff.
  automatic         Boolean           @default(false)
  /// Ledger source: `booking` (customer money for the booking) or `unapplied`.
  source            String
  cancelsBooking    Boolean           @default(false) @map("cancels_booking")
  /// Staff note; never copied to logs or audit metadata.
  note              String?
  requestedByUserId String?           @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?           @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?         @map("approved_at") @db.Timestamptz(3)
  rejectionReason   String?           @map("rejection_reason")
  providerRefundId  String?           @map("provider_refund_id")
  failureReason     String?           @map("failure_reason")
  attempts          Int               @default(0)
  processedAt       DateTime?         @map("processed_at") @db.Timestamptz(3)
  settledAt         DateTime?         @map("settled_at") @db.Timestamptz(3)
  /// When the reconciliation sweep last compared it with the ledger.
  ledgerCheckedAt   DateTime?         @map("ledger_checked_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@index([status, updatedAt])
  @@index([bookingId])
  @@index([status, ledgerCheckedAt])
  @@map("refunds")
}

/// Expiring links that open a guest booking from an email (ADR-018). Only the HMAC is stored.
model BookingAccessLink {
  id        String   @id @default(uuid(7)) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  purpose   String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_access_links")
}

enum PushPlatform {
  ios
  android
}

/// A device push token (ADR-022). The token is encrypted with the context `push-token:{id}` and
/// looked up by HMAC. It belongs to an account session (pushes stop when the session ends) or to
/// one booking (guests).
model PushToken {
  id             String       @id @default(uuid(7)) @db.Uuid
  tokenHash      String       @map("token_hash")
  tokenEncrypted String       @map("token_encrypted")
  platform       PushPlatform
  /// `session:{id}` or `booking:{id}`: one row per device and scope.
  scope          String
  userId         String?      @map("user_id") @db.Uuid
  sessionId      String?      @map("session_id") @db.Uuid
  bookingId      String?      @map("booking_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([tokenHash, scope])
  @@index([userId])
  @@index([sessionId])
  @@index([bookingId])
  @@map("push_tokens")
}

// ---------------------------------------------------------------------------
// In-house catalog: packages, tours, add-ons, visa assistance (phase 8, ADR-025 to ADR-028)
// ---------------------------------------------------------------------------

enum CatalogStatus {
  draft
  published
  archived
}

enum DepartureStatus {
  open
  closed
  cancelled
}

enum AddonProductType {
  insurance
  airport_transfer
  esim
  lounge
}

enum AddonPricingBasis {
  per_person
  per_booking
  per_day
  per_person_per_day
}

enum VisaPurpose {
  tourism
  business
  study
  transit
}

enum VisaRequirement {
  visa_free
  visa_on_arrival
  e_visa
  visa_required
  not_available
}

enum VisaApplicationStatus {
  awaiting_documents
  submitted
  in_review
  action_required
  lodged
  approved
  refused
  withdrawn
}

enum VisaDocumentStatus {
  pending_scan
  clean
  infected
  scan_failed
  rejected
}

/// A curated holiday package: flights, hotel and extras described as inclusions (ADR-025).
model TravelPackage {
  id                 String        @id @default(uuid(7)) @db.Uuid
  slug               String        @unique
  status             CatalogStatus @default(draft)
  /// Demo inventory from `db:seed:demo`; shown with a "Sample" badge.
  sample             Boolean       @default(false)
  featured           Boolean       @default(false)
  title              String
  summary            String
  cityId             String        @map("city_id") @db.Uuid
  countryCode        String        @map("country_code") @db.Char(2)
  nights             Int
  /// Travellers must give passport details at checkout (on unless staff turn it off).
  passportRequired   Boolean       @default(true) @map("passport_required")
  /// Card art key under the web app's /art route.
  artKey             String?       @map("art_key")
  highlights         Json          @default("[]")
  itinerary          Json          @default("[]")
  inclusions         Json          @default("[]")
  exclusions         Json          @default("[]")
  /// [{ daysBefore, refundBps }] (ADR-028).
  cancellationPolicy Json          @map("cancellation_policy")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  city       City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  departures PackageDeparture[]

  @@index([status, countryCode])
  @@index([cityId])
  @@map("packages")
}

/// A dated departure of a package with its capacity and per-person base prices.
model PackageDeparture {
  id             String          @id @default(uuid(7)) @db.Uuid
  packageId      String          @map("package_id") @db.Uuid
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  capacity       Int
  seatsReserved  Int             @default(0) @map("seats_reserved")
  seatsSold      Int             @default(0) @map("seats_sold")
  /// { adult, child, infant } wire money (child and infant may be null).
  prices         Json
  currency       String          @db.Char(3)
  /// Adult base price, for sorting and budget filters.
  fromPriceMinor BigInt          @map("from_price_minor")
  status         DepartureStatus @default(open)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  package      TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([packageId, startDate])
  @@index([status, startDate])
  @@map("package_departures")
}

/// A tour or activity with a meeting point and dated departures.
model Tour {
  id                 String        @id @default(uuid(7)) @db.Uuid
  slug               String        @unique
  status             CatalogStatus @default(draft)
  sample             Boolean       @default(false)
  featured           Boolean       @default(false)
  title              String
  summary            String
  cityId             String        @map("city_id") @db.Uuid
  countryCode        String        @map("country_code") @db.Char(2)
  /// IANA zone of the meeting point; departures are stored in its wall time and in UTC.
  timeZone           String        @map("time_zone")
  durationMinutes    Int           @map("duration_minutes")
  category           String?
  artKey             String?       @map("art_key")
  meetingPoint       Json          @map("meeting_point")
  highlights         Json          @default("[]")
  inclusions         Json          @default("[]")
  exclusions         Json          @default("[]")
  cancellationPolicy Json          @map("cancellation_policy")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  city       City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  departures TourDeparture[]

  @@index([status, countryCode])
  @@index([cityId])
  @@map("tours")
}

model TourDeparture {
  id             String          @id @default(uuid(7)) @db.Uuid
  tourId         String          @map("tour_id") @db.Uuid
  /// Wall time at the meeting point, YYYY-MM-DDTHH:mm.
  startsAtLocal  String          @map("starts_at_local")
  startsAtUtc    DateTime        @map("starts_at_utc") @db.Timestamptz(3)
  capacity       Int
  seatsReserved  Int             @default(0) @map("seats_reserved")
  seatsSold      Int             @default(0) @map("seats_sold")
  prices         Json
  currency       String          @db.Char(3)
  fromPriceMinor BigInt          @map("from_price_minor")
  status         DepartureStatus @default(open)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tour         Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingItems BookingItem[]

  @@index([tourId, startsAtUtc])
  @@index([status, startsAtUtc])
  @@map("tour_departures")
}

/// Insurance, airport transfer, eSIM or lounge access sold by Suskii (ADR-027).
model Addon {
  id                 String            @id @default(uuid(7)) @db.Uuid
  slug               String            @unique
  status             CatalogStatus     @default(draft)
  sample             Boolean           @default(false)
  type               AddonProductType
  title              String
  summary            String
  description        String
  /// Countries where it applies; empty means anywhere.
  countryCodes       String[]          @map("country_codes") @db.Char(2)
  pricingBasis       AddonPricingBasis @map("pricing_basis")
  /// Base unit price, wire money.
  price              Json
  currency           String            @db.Char(3)
  priceMinor         BigInt            @map("price_minor")
  maxTravellers      Int               @default(9) @map("max_travellers")
  /// AddonDetailField[] collected at checkout.
  requiredDetails    Json              @default("[]") @map("required_details")
  cancellationPolicy Json              @map("cancellation_policy")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, type])
  @@map("addons")
}

/// Eligibility for nationality x destination x purpose, maintained by visa officers (ADR-026).
model VisaRule {
  id          String          @id @default(uuid(7)) @db.Uuid
  nationality String          @db.Char(2)
  destination String          @db.Char(2)
  purpose     VisaPurpose
  requirement VisaRequirement
  maxStayDays Int?            @map("max_stay_days")
  notes       String?
  verifiedAt  DateTime?       @map("verified_at") @db.Date
  sample      Boolean         @default(false)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([nationality, destination, purpose])
  @@map("visa_rules")
}

/// Visa assistance for a destination: service fee, processing time and document checklist.
model VisaProduct {
  id                String        @id @default(uuid(7)) @db.Uuid
  slug              String        @unique
  status            CatalogStatus @default(draft)
  sample            Boolean       @default(false)
  title             String
  summary           String
  destination       String        @db.Char(2)
  purposes          VisaPurpose[]
  processingDaysMin Int           @map("processing_days_min")
  processingDaysMax Int           @map("processing_days_max")
  /// Service fee per applicant, wire money.
  price             Json
  currency          String        @db.Char(3)
  priceMinor        BigInt        @map("price_minor")
  /// [{ key, label, description, required }].
  checklist         Json
  /// Government fees are paid to the authority; this explains them (amount varies).
  governmentFeeNote String?       @map("government_fee_note")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  applications VisaApplication[]

  @@index([status, destination])
  @@map("visa_products")
}

/// One applicant's application, opened when the assistance booking is confirmed.
model VisaApplication {
  id                String                @id @default(uuid(7)) @db.Uuid
  bookingId         String                @map("booking_id") @db.Uuid
  productId         String                @map("product_id") @db.Uuid
  /// The booking passenger this application is for.
  applicantPosition Int                   @map("applicant_position")
  status            VisaApplicationStatus @default(awaiting_documents)
  purpose           VisaPurpose
  nationality       String                @db.Char(2)
  destination       String                @db.Char(2)
  travelDate        DateTime              @map("travel_date") @db.Date
  submittedAt       DateTime?             @map("submitted_at") @db.Timestamptz(3)
  closedAt          DateTime?             @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking   Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product   VisaProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  documents VisaDocument[]
  events    VisaApplicationEvent[]

  @@unique([bookingId, applicantPosition])
  @@index([status, updatedAt])
  @@map("visa_applications")
}

/// Status changes, officer messages (shown to the customer) and internal notes, append-only.
model VisaApplicationEvent {
  id            String                 @id @default(uuid(7)) @db.Uuid
  applicationId String                 @map("application_id") @db.Uuid
  kind          String
  fromStatus    VisaApplicationStatus? @map("from_status")
  toStatus      VisaApplicationStatus? @map("to_status")
  /// Visible to the customer.
  message       String?
  /// Staff only.
  note          String?
  actorType     BookingActorType       @map("actor_type")
  actorUserId   String?                @map("actor_user_id") @db.Uuid
  occurredAt    DateTime               @default(now()) @map("occurred_at") @db.Timestamptz(3)

  application VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
  @@map("visa_application_events")
}

/// An uploaded document, encrypted at rest with its own key (ADR-026).
model VisaDocument {
  id                String             @id @default(uuid(7)) @db.Uuid
  applicationId     String             @map("application_id") @db.Uuid
  checklistKey      String             @map("checklist_key")
  status            VisaDocumentStatus @default(pending_scan)
  /// Ciphertext location; null once deleted (infected, replaced or past retention).
  storageKey        String?            @map("storage_key")
  contentType       String             @map("content_type")
  sizeBytes         Int                @map("size_bytes")
  /// SHA-256 of the plaintext, hex.
  sha256            String
  /// The document's data key, wrapped by field encryption with `visa-document:{id}`.
  wrappedKey        String             @map("wrapped_key")
  /// Safe file name, encrypted with `visa-document:{id}:name`.
  fileNameEncrypted String             @map("file_name_encrypted")
  uploadedByUserId  String?            @map("uploaded_by_user_id") @db.Uuid
  uploadedAt        DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  scannedAt         DateTime?          @map("scanned_at") @db.Timestamptz(3)
  scanAttempts      Int                @default(0) @map("scan_attempts")
  /// Newer upload for the same checklist item, or officer rejection.
  supersededAt      DateTime?          @map("superseded_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)

  application VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, checklistKey])
  @@index([status, uploadedAt])
  @@map("visa_documents")
}

/// A voucher for a confirmed package, tour or add-on item (ADR-028). Only the code's HMAC is
/// looked up; the code itself is encrypted with `booking-voucher:{id}` for the PDF.
model BookingVoucher {
  id            String    @id @default(uuid(7)) @db.Uuid
  bookingId     String    @map("booking_id") @db.Uuid
  bookingItemId String    @map("booking_item_id") @db.Uuid
  codeHash      String    @unique @map("code_hash")
  codeEncrypted String    @map("code_encrypted")
  redeemedAt    DateTime? @map("redeemed_at") @db.Timestamptz(3)
  redeemedById  String?   @map("redeemed_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@unique([bookingItemId])
  @@map("booking_vouchers")
}

// ---------------------------------------------------------------------------
// Phase 9: accounts, Suskii Prime, referrals, notifications (ADR-029 to ADR-032)
// ---------------------------------------------------------------------------

/// Account preferences; absent values fall back to the client's defaults.
model UserPreference {
  userId                 String    @id @map("user_id") @db.Uuid
  locale                 String?
  currency               String?   @db.Char(3)
  homeAirport            String?   @map("home_airport") @db.Char(3)
  /// Marketing consent: when and where it was given (opt-in); null when not given or withdrawn.
  marketingConsentAt     DateTime? @map("marketing_consent_at") @db.Timestamptz(3)
  marketingConsentSource String?   @map("marketing_consent_source")
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum NotificationCategory {
  booking
  payment
  trip_reminder
  price_alert
  prime
  review_requests
  support
  marketing
}

enum NotificationChannel {
  email
  sms
  whatsapp
  push
}

/// A user's choice for one category and channel; missing rows mean the default (ADR-032).
model NotificationPreference {
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}

enum NotificationStatus {
  sent
  skipped
  failed
}

/// Delivery log: what was sent, to whom (by id) and why not. Never bodies or contact values.
model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String?              @map("user_id") @db.Uuid
  bookingId String?              @map("booking_id") @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  template  String
  status    NotificationStatus
  /// Why a message was skipped or failed (preference_off, no_verified_phone, provider_error).
  reason    String?
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookingId])
  @@map("notifications")
}

enum PrimePeriod {
  month
  year
}

/// A Suskii Prime plan (ADR-030). Prices and benefits are data entered by staff.
model PrimePlan {
  id        String        @id @default(uuid(7)) @db.Uuid
  slug      String        @unique
  name      String
  summary   String
  period    PrimePeriod
  /// [{ amountMinor, currency }], one per currency it is sold in.
  prices    Json
  /// { markupShareBps, waivedFeeCodes, prioritySupport }.
  benefits  Json
  status    CatalogStatus @default(draft)
  sample    Boolean       @default(false)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships PrimeMembership[]

  @@map("prime_plans")
}

enum PrimeMembershipStatus {
  active
  cancelled
}

/// One paid membership term (a purchase); a member has a term covering now (ADR-030).
model PrimeMembership {
  id             String                @id @default(uuid(7)) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  planId         String                @map("plan_id") @db.Uuid
  bookingId      String                @unique @map("booking_id") @db.Uuid
  status         PrimeMembershipStatus @default(active)
  startsAt       DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime              @map("ends_at") @db.Timestamptz(3)
  /// The plan's benefits when bought: later plan edits do not change a running term.
  benefits       Json
  reminderSentAt DateTime?             @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan PrimePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, endsAt])
  @@index([status, endsAt])
  @@map("prime_memberships")
}

/// Each account's referral code (ADR-031).
model ReferralCode {
  userId    String   @id @map("user_id") @db.Uuid
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

enum ReferralStatus {
  pending
  qualified
  rewarded
  review
  rejected
}

/// A referred sign-up and its path to a reward (ADR-031). Signals are HMACs, never values.
model Referral {
  id                  String         @id @default(uuid(7)) @db.Uuid
  referrerId          String         @map("referrer_id") @db.Uuid
  refereeId           String         @unique @map("referee_id") @db.Uuid
  code                String
  status              ReferralStatus @default(pending)
  /// Fraud flags that sent it to review or rejected it.
  flags               String[]       @default([])
  /// { email, phone, network, device } HMACs captured at sign-up.
  signals             Json
  qualifyingBookingId String?        @map("qualifying_booking_id") @db.Uuid
  qualifiedAt         DateTime?      @map("qualified_at") @db.Timestamptz(3)
  rewardedAt          DateTime?      @map("rewarded_at") @db.Timestamptz(3)
  reviewedById        String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
  @@index([status])
  @@map("referrals")
}

/// A watched flight route (ADR-032).
model PriceAlert {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  origin            String     @db.Char(3)
  destination       String     @db.Char(3)
  /// Exact departure date, or a month (YYYY-MM) to watch its cheapest date.
  departureDate     DateTime?  @map("departure_date") @db.Date
  departureMonth    String?    @map("departure_month")
  cabinClass        CabinClass @default(economy) @map("cabin_class")
  currency          String     @db.Char(3)
  targetMinor       BigInt?    @map("target_minor")
  lastPriceMinor    BigInt?    @map("last_price_minor")
  lastCheckedAt     DateTime?  @map("last_checked_at") @db.Timestamptz(3)
  lastNotifiedAt    DateTime?  @map("last_notified_at") @db.Timestamptz(3)
  lastNotifiedMinor BigInt?    @map("last_notified_minor")
  active            Boolean    @default(true)
  /// The alert retires after this date (the departure date or the month's last day).
  endsOn            DateTime   @map("ends_on") @db.Date
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active, lastCheckedAt])
  @@map("price_alerts")
}

// ---------------------------------------------------------------------------
// Admin console (phase 10, ADR-033 to ADR-036)
// ---------------------------------------------------------------------------

/// Internal note staff add to a booking. Never shown to travellers; the text is encrypted with
/// the context `booking-note:{id}` because staff may record personal details.
model BookingNote {
  id            String   @id @default(uuid(7)) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  bodyEncrypted String   @map("body_encrypted")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_notes")
}

// ---------------------------------------------------------------------------
// Cars: interstate buses, intrastate rides and car rental (ADR-049 to ADR-053)
// ---------------------------------------------------------------------------

enum BusTripStatus {
  scheduled
  boarding
  departed
  cancelled
}

enum BusTicketStatus {
  valid
  boarded
  void
}

enum RideCategory {
  standard
  comfort
  xl
}

enum RideStatus {
  scheduled
  searching
  assigned
  arrived
  in_progress
  completed
  cancelled
  no_driver
}

enum RideOfferStatus {
  open
  accepted
  declined
  expired
  withdrawn
}

enum DriverStatus {
  pending
  approved
  rejected
  suspended
}

/// Vehicles a driver registers are reviewed like documents.
enum ReviewStatus {
  pending
  approved
  rejected
}

enum DriverDocumentKind {
  licence
  vehicle_registration
  insurance
  roadworthiness
  selfie
}

enum DriverDocumentStatus {
  pending
  clean
  approved
  rejected
}

enum IncidentKind {
  sos
  route_deviation
  pin_lockout
  long_stop
}

enum IncidentStatus {
  open
  acknowledged
  resolved
}

enum RentalCategory {
  economy
  compact
  suv
  luxury
  van
}

enum Transmission {
  automatic
  manual
}

enum RentalStatus {
  reserved
  checked_out
  returned
  cancelled
}

enum HandoverKind {
  check_out
  check_in
}

enum PayoutStatus {
  pending
  paid
  failed
}

/// A bus company whose tickets Suskii sells from inventory entered by staff (ADR-049).
model BusOperator {
  id                 String        @id @default(uuid(7)) @db.Uuid
  slug               String        @unique
  name               String
  status             CatalogStatus @default(draft)
  /// Demo inventory (`db:seed:demo`), badged "Sample".
  sample             Boolean       @default(false)
  /// Cancellation tiers for this operator's tickets (`CancellationTier[]`).
  cancellationPolicy Json          @map("cancellation_policy")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  routes  BusRoute[]
  layouts BusLayout[]
  members OperatorMember[]

  @@map("bus_operators")
}

/// Accounts that board this operator's passengers (role `operator_agent`, ADR-050).
model OperatorMember {
  operatorId String   @map("operator_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  operator BusOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([operatorId, userId])
  @@index([userId])
  @@map("operator_members")
}

/// A bus park or terminal, shared by the operators that use it.
model BusTerminal {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  cityName    String   @map("city_name")
  stateName   String   @map("state_name")
  countryCode String   @map("country_code") @db.Char(2)
  address     String
  lat         Float
  lng         Float
  timeZone    String   @map("time_zone")
  active      Boolean  @default(true)
  sample      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  departures BusRoute[] @relation("BusRouteOrigin")
  arrivals   BusRoute[] @relation("BusRouteDestination")

  @@index([cityName])
  @@map("bus_terminals")
}

/// An operator's service between two terminals.
model BusRoute {
  id              String   @id @default(uuid(7)) @db.Uuid
  operatorId      String   @map("operator_id") @db.Uuid
  originId        String   @map("origin_terminal_id") @db.Uuid
  destinationId   String   @map("destination_terminal_id") @db.Uuid
  distanceKm      Int      @map("distance_km")
  durationMinutes Int      @map("duration_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator    BusOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  origin      BusTerminal @relation("BusRouteOrigin", fields: [originId], references: [id], onDelete: Restrict)
  destination BusTerminal @relation("BusRouteDestination", fields: [destinationId], references: [id], onDelete: Restrict)
  trips       BusTrip[]

  @@unique([operatorId, originId, destinationId])
  @@index([originId, destinationId])
  @@map("bus_routes")
}

/// A coach type and its seat map (`BusSeatLayout`).
model BusLayout {
  id         String   @id @default(uuid(7)) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  name       String
  layout     Json
  seatCount  Int      @map("seat_count")
  amenities  String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator BusOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  trips    BusTrip[]

  @@index([operatorId])
  @@map("bus_layouts")
}

/// A dated departure with its fare and coach.
model BusTrip {
  id             String        @id @default(uuid(7)) @db.Uuid
  routeId        String        @map("route_id") @db.Uuid
  layoutId       String        @map("layout_id") @db.Uuid
  departsAt      DateTime      @map("departs_at") @db.Timestamptz(3)
  /// Wall time at the origin terminal, YYYY-MM-DDTHH:mm.
  departsAtLocal String        @map("departs_at_local")
  arrivesAt      DateTime      @map("arrives_at") @db.Timestamptz(3)
  fareMinor      BigInt        @map("fare_minor")
  currency       String        @db.Char(3)
  status         BusTripStatus @default(scheduled)
  /// Seats kept off sale (crew, a broken seat).
  blockedSeats   String[]      @default([]) @map("blocked_seats")
  sample         Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  route       BusRoute            @relation(fields: [routeId], references: [id], onDelete: Restrict)
  layout      BusLayout           @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  holds       BusSeatHold[]
  assignments BusSeatAssignment[]
  tickets     BusTicket[]

  @@index([routeId, departsAt])
  @@index([status, departsAt])
  @@map("bus_trips")
}

/// The record of a seat hold; Redis decides while it lives (ADR-051).
model BusSeatHold {
  id             String    @id @default(uuid(7)) @db.Uuid
  tripId         String    @map("trip_id") @db.Uuid
  seats          String[]
  /// The holder: an account, or an HMAC of the guest's hold token.
  userId         String?   @map("user_id") @db.Uuid
  guestTokenHash String?   @map("guest_token_hash")
  /// HMAC of the client IP, for the per-IP limit on live holds.
  ipHash         String    @map("ip_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(3)
  /// Set when a booking took the seats.
  bookingItemId  String?   @unique @map("booking_item_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  trip BusTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, expiresAt])
  @@index([userId, expiresAt])
  @@index([ipHash, expiresAt])
  @@index([expiresAt])
  @@map("bus_seat_holds")
}

/// A seat sold to a booking item; released (`active` false) with the booking (ADR-051).
model BusSeatAssignment {
  id            String    @id @default(uuid(7)) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  seatNumber    String    @map("seat_number")
  bookingItemId String    @map("booking_item_id") @db.Uuid
  /// The booking passenger in this seat.
  passengerId   String    @map("passenger_id") @db.Uuid
  active        Boolean   @default(true)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  trip        BusTrip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@index([bookingItemId])
  @@index([tripId])
  @@map("bus_seat_assignments")
}

/// A boarding pass per seat (ADR-050). Its QR payload is signed on demand, never stored.
model BusTicket {
  id            String          @id @default(uuid(7)) @db.Uuid
  bookingId     String          @map("booking_id") @db.Uuid
  bookingItemId String          @map("booking_item_id") @db.Uuid
  tripId        String          @map("trip_id") @db.Uuid
  seatNumber    String          @map("seat_number")
  passengerId   String          @map("passenger_id") @db.Uuid
  status        BusTicketStatus @default(valid)
  boardedAt     DateTime?       @map("boarded_at") @db.Timestamptz(3)
  boardedById   String?         @map("boarded_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem     @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  trip        BusTrip         @relation(fields: [tripId], references: [id], onDelete: Restrict)
  scans       BusTicketScan[]

  @@index([bookingItemId])
  @@index([tripId])
  @@map("bus_tickets")
}

/// Every scan of a ticket, online or uploaded later from an offline scanner (ADR-050).
model BusTicketScan {
  id          String   @id @default(uuid(7)) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  agentUserId String   @map("agent_user_id") @db.Uuid
  /// When the agent scanned (the device clock for offline scans).
  scannedAt   DateTime @map("scanned_at") @db.Timestamptz(3)
  offline     Boolean  @default(false)
  /// `boarded`, `already_boarded` or `void`.
  result      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket BusTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
  @@map("bus_ticket_scans")
}

/// Places riders pick from: terminals, airports and landmarks entered by staff (ADR-053).
model RidePlace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// `airport`, `terminal` or `landmark`.
  kind      String
  cityName  String   @map("city_name")
  lat       Float
  lng       Float
  active    Boolean  @default(true)
  sample    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([cityName, active])
  @@map("ride_places")
}

/// Ride fares per city and category (ADR-051): data, not code.
model RideFareRule {
  id                   String       @id @default(uuid(7)) @db.Uuid
  cityName             String       @map("city_name")
  category             RideCategory
  currency             String       @db.Char(3)
  baseMinor            BigInt       @map("base_minor")
  perKmMinor           BigInt       @map("per_km_minor")
  perMinuteMinor       BigInt       @map("per_minute_minor")
  bookingFeeMinor      BigInt       @map("booking_fee_minor")
  minimumMinor         BigInt       @map("minimum_minor")
  cancellationFeeMinor BigInt       @map("cancellation_fee_minor")
  freeCancelSeconds    Int          @map("free_cancel_seconds")
  waitGraceSeconds     Int          @map("wait_grace_seconds")
  driverShareBps       Int          @map("driver_share_bps")
  /// Demand pricing set by staff; capped at RIDE_SURGE_CAP_BPS when applied.
  surgeBps             Int          @default(0) @map("surge_bps")
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([cityName, category])
  @@map("ride_fare_rules")
}

/// A vetted independent driver (ADR-050). Identity numbers are encrypted and HMAC-indexed.
model Driver {
  id                     String       @id @default(uuid(7)) @db.Uuid
  userId                 String       @unique @map("user_id") @db.Uuid
  status                 DriverStatus @default(pending)
  /// Demo drivers (`db:seed:demo`), badged "Sample".
  sample                 Boolean      @default(false)
  givenNames             String       @map("given_names")
  surname                String
  dateOfBirth            DateTime     @map("date_of_birth") @db.Date
  cityName               String       @map("city_name")
  ninEncrypted           String       @map("nin_encrypted")
  /// HMAC of the NIN: one driver account per person.
  ninHash                String       @unique @map("nin_hash")
  /// KYC outcomes (`verified`, `mismatch`, `not_found`, `pending`) and provider references.
  identityCheck          String       @default("pending") @map("identity_check")
  identityReference      String?      @map("identity_reference")
  licenceEncrypted       String       @map("licence_encrypted")
  licenceHash            String       @unique @map("licence_hash")
  licenceExpiresOn       DateTime     @map("licence_expires_on") @db.Date
  licenceCheck           String       @default("pending") @map("licence_check")
  licenceReference       String?      @map("licence_reference")
  /// Bank details for payouts (`{ bankCode, accountNumber, accountName }`), encrypted.
  payoutAccountEncrypted String?      @map("payout_account_encrypted")
  /// When the bank details last changed: a payout the bank rejected waits for new ones.
  payoutAccountUpdatedAt DateTime?    @map("payout_account_updated_at") @db.Timestamptz(3)
  ratingSum              Int          @default(0) @map("rating_sum")
  ratingCount            Int          @default(0) @map("rating_count")
  online                 Boolean      @default(false)
  /// Last position, kept only while online (ADR-053).
  lastLat                Float?       @map("last_lat")
  lastLng                Float?       @map("last_lng")
  lastLocationAt         DateTime?    @map("last_location_at") @db.Timestamptz(3)
  reviewedById           String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt             DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  /// Why an application was rejected or a driver suspended (a short staff reason, no personal data).
  statusReason           String?      @map("status_reason")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicles         DriverVehicle[]
  documents        DriverDocument[]
  rides            Ride[]
  offers           RideOffer[]
  payouts          DriverPayout[]
  chauffeurRentals RentalReservation[]

  @@index([status, online])
  @@map("drivers")
}

model DriverVehicle {
  id                 String       @id @default(uuid(7)) @db.Uuid
  driverId           String       @map("driver_id") @db.Uuid
  make               String
  model              String
  year               Int
  colour             String
  plate              String       @unique
  category           RideCategory
  seats              Int
  insuranceExpiresOn DateTime     @map("insurance_expires_on") @db.Date
  status             ReviewStatus @default(pending)
  /// The vehicle the driver drives today; at most one per driver.
  active             Boolean      @default(false)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rides  Ride[]

  @@index([driverId])
  @@map("driver_vehicles")
}

/// A driver's document, sealed like visa documents (ADR-026, ADR-050).
model DriverDocument {
  id              String               @id @default(uuid(7)) @db.Uuid
  driverId        String               @map("driver_id") @db.Uuid
  kind            DriverDocumentKind
  status          DriverDocumentStatus @default(pending)
  storageKey      String?              @map("storage_key")
  contentType     String               @map("content_type")
  sizeBytes       Int                  @map("size_bytes")
  sha256          String
  /// Per-document key wrapped with `driver-document:{id}`; wiped on deletion.
  wrappedKey      String               @map("wrapped_key")
  expiresOn       DateTime?            @map("expires_on") @db.Date
  reviewedById    String?              @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?              @map("rejection_reason")
  supersededAt    DateTime?            @map("superseded_at") @db.Timestamptz(3)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, kind])
  @@index([status, createdAt])
  @@map("driver_documents")
}

/// A paid ride, created when its booking is confirmed (ADR-049).
model Ride {
  id                   String       @id @default(uuid(7)) @db.Uuid
  bookingId            String       @unique @map("booking_id") @db.Uuid
  bookingItemId        String       @unique @map("booking_item_id") @db.Uuid
  riderUserId          String       @map("rider_user_id") @db.Uuid
  driverId             String?      @map("driver_id") @db.Uuid
  vehicleId            String?      @map("vehicle_id") @db.Uuid
  category             RideCategory
  status               RideStatus
  cityName             String       @map("city_name")
  pickupLabel          String       @map("pickup_label")
  pickupLat            Float        @map("pickup_lat")
  pickupLng            Float        @map("pickup_lng")
  dropoffLabel         String       @map("dropoff_label")
  dropoffLat           Float        @map("dropoff_lat")
  dropoffLng           Float        @map("dropoff_lng")
  /// Null for "now" rides.
  scheduledFor         DateTime?    @map("scheduled_for") @db.Timestamptz(3)
  /// Planned route (encoded polyline); cleared by the retention sweep.
  polyline             String
  distanceMetres       Int          @map("distance_metres")
  durationSeconds      Int          @map("duration_seconds")
  fareMinor            BigInt       @map("fare_minor")
  currency             String       @db.Char(3)
  /// argon2id hash of the four-digit PIN (ADR-050).
  pinHash              String       @map("pin_hash")
  /// The PIN itself, encrypted with `ride:{id}:pin`, so the rider's screen can show it.
  pinEncrypted         String       @map("pin_encrypted")
  pinAttempts          Int          @default(0) @map("pin_attempts")
  pinLockedAt          DateTime?    @map("pin_locked_at") @db.Timestamptz(3)
  searchStartedAt      DateTime?    @map("search_started_at") @db.Timestamptz(3)
  assignedAt           DateTime?    @map("assigned_at") @db.Timestamptz(3)
  arrivedAt            DateTime?    @map("arrived_at") @db.Timestamptz(3)
  startedAt            DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  /// `rider`, `driver`, `staff` or `system`.
  cancelledBy          String?      @map("cancelled_by")
  cancellationFeeMinor BigInt?      @map("cancellation_fee_minor")
  /// Since when the driver has been off the planned route (ADR-053); null when on it.
  offRouteSince        DateTime?    @map("off_route_since") @db.Timestamptz(3)
  /// Location data was coarsened by the retention sweep.
  locationsRedactedAt  DateTime?    @map("locations_redacted_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingItem BookingItem        @relation(fields: [bookingItemId], references: [id], onDelete: Restrict)
  rider       User               @relation("RideRider", fields: [riderUserId], references: [id], onDelete: Restrict)
  driver      Driver?            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle     DriverVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  events      RideEvent[]
  offers      RideOffer[]
  pings       RideLocationPing[]
  ratings     RideRating[]
  shareLinks  RideShareLink[]
  incidents   SafetyIncident[]

  @@index([status, scheduledFor])
  @@index([riderUserId, createdAt])
  @@index([driverId, createdAt])
  @@index([completedAt])
  @@map("rides")
}

/// Every ride state change and who caused it (ADR-050).
model RideEvent {
  id          String     @id @default(uuid(7)) @db.Uuid
  rideId      String     @map("ride_id") @db.Uuid
  event       String
  fromStatus  RideStatus @map("from_status")
  toStatus    RideStatus @map("to_status")
  /// `rider`, `driver`, `staff` or `system`.
  actorKind   String     @map("actor_kind")
  actorUserId String?    @map("actor_user_id") @db.Uuid
  /// Ids and reasons only.
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
  @@map("ride_events")
}

/// A ride offered to one driver for `RIDE_OFFER_SECONDS` (ADR-052).
model RideOffer {
  id             String          @id @default(uuid(7)) @db.Uuid
  rideId         String          @map("ride_id") @db.Uuid
  driverId       String          @map("driver_id") @db.Uuid
  status         RideOfferStatus @default(open)
  /// Straight-line distance from the driver to the pickup when offered.
  distanceMetres Int             @map("distance_metres")
  expiresAt      DateTime        @map("expires_at") @db.Timestamptz(3)
  respondedAt    DateTime?       @map("responded_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([rideId, driverId])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("ride_offers")
}

/// Driver positions during a ride, kept RIDE_PING_RETENTION_DAYS (ADR-053).
model RideLocationPing {
  id         String   @id @default(uuid(7)) @db.Uuid
  rideId     String   @map("ride_id") @db.Uuid
  lat        Float
  lng        Float
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, recordedAt])
  @@index([createdAt])
  @@map("ride_location_pings")
}

model RideRating {
  id        String   @id @default(uuid(7)) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  /// `rider` rates the driver; `driver` rates the rider.
  raterKind String   @map("rater_kind")
  stars     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, raterKind])
  @@map("ride_ratings")
}

/// A live-trip link (ADR-050): a 128-bit token stored as an HMAC.
model RideShareLink {
  id        String    @id @default(uuid(7)) @db.Uuid
  rideId    String    @map("ride_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([expiresAt])
  @@map("ride_share_links")
}

/// SOS alerts and automatic safety signals for staff triage (ADR-050).
model SafetyIncident {
  id               String         @id @default(uuid(7)) @db.Uuid
  kind             IncidentKind
  status           IncidentStatus @default(open)
  rideId           String?        @map("ride_id") @db.Uuid
  reporterUserId   String?        @map("reporter_user_id") @db.Uuid
  /// Where it happened (full precision, staff only).
  lat              Float?
  lng              Float?
  acknowledgedById String?        @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt   DateTime?      @map("acknowledged_at") @db.Timestamptz(3)
  resolvedById     String?        @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?      @map("resolved_at") @db.Timestamptz(3)
  /// `false_alarm`, `assisted`, `escalated_to_police`, `driver_suspended` or `other`.
  resolution       String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  ride Ride? @relation(fields: [rideId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([rideId])
  @@map("safety_incidents")
}

/// A rider's trusted contact, texted on SOS (ADR-050); name and phone encrypted together.
model EmergencyContact {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  position         Int
  /// `{ name, phone }` encrypted with `emergency-contact:{id}`.
  contactEncrypted String   @map("contact_encrypted")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@map("emergency_contacts")
}

/// A transfer of a driver's earnings to their bank (ADR-051). At most one is pending per driver
/// and currency (partial unique index `driver_payouts_one_pending`).
model DriverPayout {
  id                String       @id @default(uuid(7)) @db.Uuid
  driverId          String       @map("driver_id") @db.Uuid
  amountMinor       BigInt       @map("amount_minor")
  currency          String       @db.Char(3)
  status            PayoutStatus @default(pending)
  provider          String
  providerReference String?      @map("provider_reference")
  failureReason     String?      @map("failure_reason")
  /// The payout run that sent it; one provider batch per run.
  batchId           String?      @map("batch_id") @db.Uuid
  /// Provider calls made for it (a lost answer is asked again with the same reference).
  attempts          Int          @default(0)
  ledgerCheckedAt   DateTime?    @map("ledger_checked_at") @db.Timestamptz(3)
  settledAt         DateTime?    @map("settled_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, createdAt])
  @@index([status])
  @@index([batchId])
  @@index([status, ledgerCheckedAt])
  @@map("driver_payouts")
}

enum DiscrepancyKind {
  ledger_missing
  ledger_amount
  provider_status
  provider_amount
  orphan_ledger
}

enum DiscrepancySubject {
  payment
  refund
  payout
}

enum DiscrepancyStatus {
  open
  resolved
}

enum DiscrepancyResolution {
  /// The underlying record was fixed; the next sweep checks it again and reopens it if not.
  corrected
  /// A known difference (a provider fee, a manual transfer); it stays resolved.
  accepted
}

/// Where the ledger, our payment records and the provider disagree (ADR-051). Ids and amounts only.
model ReconciliationDiscrepancy {
  id            String                 @id @default(uuid(7)) @db.Uuid
  kind          DiscrepancyKind
  subjectType   DiscrepancySubject     @map("subject_type")
  subjectId     String                 @map("subject_id") @db.Uuid
  bookingId     String?                @map("booking_id") @db.Uuid
  currency      String?                @db.Char(3)
  expectedMinor BigInt?                @map("expected_minor")
  actualMinor   BigInt?                @map("actual_minor")
  status        DiscrepancyStatus      @default(open)
  resolution    DiscrepancyResolution?
  resolvedById  String?                @map("resolved_by_id") @db.Uuid
  resolvedAt    DateTime?              @map("resolved_at") @db.Timestamptz(3)
  detectedAt    DateTime               @default(now()) @map("detected_at") @db.Timestamptz(3)
  lastSeenAt    DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  @@unique([subjectType, subjectId, kind], map: "reconciliation_discrepancies_subject_id_kind_key")
  @@index([status, detectedAt])
  @@map("reconciliation_discrepancies")
}

/// A car Suskii rents out, with or without a chauffeur (ADR-051).
model RentalVehicle {
  id                  String         @id @default(uuid(7)) @db.Uuid
  slug                String         @unique
  status              CatalogStatus  @default(draft)
  sample              Boolean        @default(false)
  make                String
  model               String
  year                Int
  category            RentalCategory
  transmission        Transmission
  seats               Int
  plate               String         @unique
  features            String[]       @default([])
  artKey              String?        @map("art_key")
  cityName            String         @map("city_name")
  branchName          String         @map("branch_name")
  branchAddress       String         @map("branch_address")
  lat                 Float
  lng                 Float
  timeZone            String         @map("time_zone")
  currency            String         @db.Char(3)
  dailyMinor          BigInt         @map("daily_minor")
  /// Null when the car is not offered with a chauffeur.
  chauffeurDailyMinor BigInt?        @map("chauffeur_daily_minor")
  depositMinor        BigInt         @map("deposit_minor")
  /// Delivery to the customer's address, per started kilometre; null when not offered.
  deliveryPerKmMinor  BigInt?        @map("delivery_per_km_minor")
  /// Furthest delivery from the branch, straight-line kilometres.
  deliveryMaxKm       Int?           @map("delivery_max_km")
  /// Kilometres included per rental day; null for unlimited mileage.
  mileageKmPerDay     Int?           @map("mileage_km_per_day")
  /// Charged per kilometre over the allowance, deducted from the deposit at return.
  excessKmMinor       BigInt?        @map("excess_km_minor")
  /// `full_to_full` or `same_to_same`.
  fuelPolicy          String         @default("full_to_full") @map("fuel_policy")
  /// What the price includes (e.g. comprehensive cover, excess), shown with the car.
  insuranceSummary    String         @default("") @map("insurance_summary")
  /// Photos on `IMAGE_REMOTE_HOSTS` (https only).
  photoUrls           String[]       @default([]) @map("photo_urls")
  /// Cancellation tiers (`CancellationTier[]`).
  cancellationPolicy  Json           @map("cancellation_policy")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservations RentalReservation[]

  @@index([cityName, status])
  @@map("rental_vehicles")
}

/// A booked rental period. An exclusion constraint keeps active periods of one car apart.
model RentalReservation {
  id                     String       @id @default(uuid(7)) @db.Uuid
  vehicleId              String       @map("vehicle_id") @db.Uuid
  bookingItemId          String       @unique @map("booking_item_id") @db.Uuid
  pickupAt               DateTime     @map("pickup_at") @db.Timestamptz(3)
  returnAt               DateTime     @map("return_at") @db.Timestamptz(3)
  /// `returnAt` plus the turnaround buffer: the end of the blocked period.
  blockedUntil           DateTime     @map("blocked_until") @db.Timestamptz(3)
  chauffeur              Boolean
  status                 RentalStatus @default(reserved)
  /// False once the booking releases the car (expired, cancelled, refunded).
  active                 Boolean      @default(true)
  depositMinor           BigInt       @map("deposit_minor")
  currency               String       @db.Char(3)
  depositReleasedAt      DateTime?    @map("deposit_released_at") @db.Timestamptz(3)
  depositDeductionMinor  BigInt?      @map("deposit_deduction_minor")
  /// Why part of the deposit was kept (`damage`, `fuel`, `excess_mileage`, `late_return`, ...).
  depositDeductionReason String?      @map("deposit_deduction_reason")
  /// Self-drive rentals need a reviewed driver's licence before check-out.
  licenceRequired        Boolean      @default(false) @map("licence_required")
  /// The vetted driver who chauffeurs, assigned at check-out.
  chauffeurDriverId      String?      @map("chauffeur_driver_id") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle         RentalVehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookingItem     BookingItem           @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  chauffeurDriver Driver?               @relation(fields: [chauffeurDriverId], references: [id], onDelete: Restrict)
  handovers       RentalHandover[]
  licence         RentalLicence?
  photos          RentalHandoverPhoto[]

  @@index([vehicleId, pickupAt])
  @@map("rental_reservations")
}

/// The car's state when it leaves and when it comes back.
model RentalHandover {
  id            String       @id @default(uuid(7)) @db.Uuid
  reservationId String       @map("reservation_id") @db.Uuid
  kind          HandoverKind
  odometerKm    Int          @map("odometer_km")
  fuelEighths   Int          @map("fuel_eighths")
  damageNotes   String?      @map("damage_notes")
  recordedById  String       @map("recorded_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation RentalReservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  photos      RentalHandoverPhoto[]

  @@unique([reservationId, kind])
  @@map("rental_handovers")
}

/// The renter's driver's licence for a self-drive rental (ADR-050): number encrypted, the scan
/// sealed like a visa document, reviewed by staff before check-out.
model RentalLicence {
  id              String    @id @default(uuid(7)) @db.Uuid
  reservationId   String    @unique @map("reservation_id") @db.Uuid
  numberEncrypted String    @map("number_encrypted")
  expiresOn       DateTime  @map("expires_on") @db.Date
  /// `pending_upload`, `pending_scan`, `pending_review`, `approved` or `rejected`.
  status          String    @default("pending_upload")
  storageKey      String?   @map("storage_key")
  /// Data key of the scan, wrapped with `rental-licence:{id}`; wiped on deletion.
  wrappedKey      String    @default("") @map("wrapped_key")
  sha256          String?
  contentType     String?   @map("content_type")
  sizeBytes       Int?      @map("size_bytes")
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("rental_licences")
}

/// Photo evidence at check-out and check-in, sealed with a per-photo key (`rental-photo:{id}`).
/// Attached to its handover once, then immutable (database trigger).
model RentalHandoverPhoto {
  id            String    @id @default(uuid(7)) @db.Uuid
  reservationId String    @map("reservation_id") @db.Uuid
  handoverId    String?   @map("handover_id") @db.Uuid
  storageKey    String?   @map("storage_key")
  wrappedKey    String    @map("wrapped_key")
  sha256        String
  contentType   String    @map("content_type")
  sizeBytes     Int       @map("size_bytes")
  uploadedById  String    @map("uploaded_by_id") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation RentalReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  handover    RentalHandover?   @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([handoverId])
  @@map("rental_handover_photos")
}

// --- Partner supply (ADR-069, ADR-070) ------------------------------------------------------

/// What an affiliate partner sells (ADR-069).
enum PartnerCategory {
  car_rental
  transfer
  activity
  esim
  insurance
}

/// Who tracks the click and pays the commission.
enum AffiliateNetwork {
  mock
  travelpayouts
  viator
}

enum PartnerConversionStatus {
  pending
  confirmed
  cancelled
}

enum MetasearchLandingOutcome {
  same
  lower
  higher
  unavailable
  expired
}

/// A metasearch engine allowed to price our flights (ADR-081). The key is stored only as an HMAC.
model MetasearchPartner {
  id                String              @id @default(uuid(7)) @db.Uuid
  name              String
  /// Short lowercase code shown in reports and metrics.
  code              String              @unique
  /// HMAC (`metasearch-key`) of the API key; the key itself is shown once.
  keyHash           String              @unique @map("key_hash")
  /// The first characters of the key, so staff can recognise it.
  keyPrefix         String              @map("key_prefix")
  active            Boolean             @default(true)
  requestsPerMinute Int                 @map("requests_per_minute")
  requestsPerDay    Int                 @map("requests_per_day")
  maxResults        Int                 @map("max_results")
  keyRotatedAt      DateTime            @map("key_rotated_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  landings          MetasearchLanding[]

  @@map("metasearch_partners")
}

/// A traveller arriving through a metasearch deep link, and whether the partner's price held.
/// No personal data: the partner, the outcome and the two totals.
model MetasearchLanding {
  id          String                   @id @default(uuid(7)) @db.Uuid
  partnerId   String                   @map("partner_id") @db.Uuid
  outcome     MetasearchLandingOutcome
  /// The total the partner showed, in `currency`.
  shownMinor  BigInt                   @map("shown_minor")
  /// The total quoted on arrival; null when the flight was gone or the link had expired.
  landedMinor BigInt?                  @map("landed_minor")
  currency    String                   @db.Char(3)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  partner     MetasearchPartner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  offers      Offer[]
  bookings    Booking[]

  @@index([partnerId, createdAt])
  @@index([createdAt])
  @@map("metasearch_landings")
}

/// An outbound click on a partner offer (ADR-070). Ids only: no IP address, browser or URL.
/// The id is the `sub_id` the network reports back on a conversion.
model PartnerClick {
  id        String           @id @default(uuid(7)) @db.Uuid
  /// A key of the programme catalogue (`src/partners/partner-programs.ts`).
  programId String           @map("program_id") @db.VarChar(40)
  category  PartnerCategory
  network   AffiliateNetwork
  userId    String?          @map("user_id") @db.Uuid
  /// The trip the offer was shown with (cross-sell), when there was one.
  bookingId String?          @map("booking_id") @db.Uuid
  channel   SalesChannel?
  /// Viator's campaign value from the search that produced the link.
  campaign  String?          @db.VarChar(64)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking     Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  conversions PartnerConversion[]

  @@index([programId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("partner_clicks")
}

/// A booking a network reported for one of our clicks (postback). Revenue record: the network's
/// id, amounts and status, no personal data.
model PartnerConversion {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  network            AffiliateNetwork
  /// The network's booking or action id.
  externalId         String                  @map("external_id") @db.VarChar(128)
  /// Unknown or purged clicks leave this empty; the network still pays.
  clickId            String?                 @map("click_id") @db.Uuid
  programId          String?                 @map("program_id") @db.VarChar(40)
  status             PartnerConversionStatus
  priceMinor         BigInt?                 @map("price_minor")
  priceCurrency      String?                 @map("price_currency") @db.Char(3)
  commissionMinor    BigInt?                 @map("commission_minor")
  commissionCurrency String?                 @map("commission_currency") @db.Char(3)
  confirmedAt        DateTime?               @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  click PartnerClick? @relation(fields: [clickId], references: [id], onDelete: SetNull)

  @@unique([network, externalId])
  @@index([programId, createdAt])
  @@index([clickId])
  @@map("partner_conversions")
}

// ---------------------------------------------------------------------------
// Verified reviews (ADR-077)
// ---------------------------------------------------------------------------

enum ReviewSubjectKind {
  hotel
  package
  tour
  bus_operator
  rental_vehicle
}

enum TravellerReviewStatus {
  pending
  published
  rejected
}

enum ReviewTripType {
  solo
  couple
  family
  friends
  business
}

/// What travellers review: a catalog product by id, or a hotel matched by name and place across
/// suppliers (ADR-077). Keeps the sum and count of published ratings.
model ReviewSubject {
  id          String            @id @default(uuid(7)) @db.Uuid
  kind        ReviewSubjectKind
  /// The package, tour, bus operator or rental vehicle; null for hotels.
  refId       String?           @map("ref_id") @db.Uuid
  /// Hotels: the normalised name (`hotelNameKey`) and the position they are matched by.
  nameKey     String?           @map("name_key")
  latitude    Float?
  longitude   Float?
  name        String
  ratingSum   Int               @default(0) @map("rating_sum")
  ratingCount Int               @default(0) @map("rating_count")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviews Review[]

  @@unique([kind, refId])
  @@index([kind, nameKey])
  @@map("review_subjects")
}

/// A verified review: one per booking item, written after the trip, shown once a moderator
/// publishes it (ADR-077). Nobody edits a traveller's words.
model Review {
  id            String                @id @default(uuid(7)) @db.Uuid
  subjectId     String                @map("subject_id") @db.Uuid
  bookingId     String                @map("booking_id") @db.Uuid
  bookingItemId String                @unique @map("booking_item_id") @db.Uuid
  /// The account that wrote it; null for guest bookings and after account deletion.
  userId        String?               @map("user_id") @db.Uuid
  rating        Int                   @db.SmallInt
  title         String?
  liked         String?
  disliked      String?
  tripType      ReviewTripType        @map("trip_type")
  /// "Ada O.", or null to show "Verified traveller".
  displayName   String?               @map("display_name")
  locale        String
  /// The month the trip ended (YYYY-MM).
  travelledOn   String                @map("travelled_on") @db.Char(7)
  /// What the automatic check found: contact_details, link.
  flags         String[]              @default([])
  status        TravellerReviewStatus @default(pending)
  /// A reject reason code; never free text.
  rejectReason  String?               @map("reject_reason")
  moderatedById String?               @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?             @map("moderated_at") @db.Timestamptz(3)
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  subject     ReviewSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem   @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subjectId, status, publishedAt])
  @@index([status, createdAt])
  @@index([userId])
  @@index([bookingId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Company accounts (ADR-078)
// ---------------------------------------------------------------------------

enum CompanyStatus {
  active
  suspended
}

enum CompanyRole {
  admin
  approver
  booker
  traveller
}

enum ApprovalMode {
  never
  out_of_policy
  always
}

enum BookingApprovalStatus {
  not_required
  pending
  approved
  rejected
}

/// A company that books travel for its people.
model Company {
  id                 String        @id @default(uuid(7)) @db.Uuid
  name               String
  countryCode        String        @map("country_code") @db.Char(2)
  registrationNumber String?       @map("registration_number")
  taxId              String?       @map("tax_id")
  billingEmail       String        @map("billing_email")
  status             CompanyStatus @default(active)
  createdById        String?       @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  members     CompanyMember[]
  invitations CompanyInvitation[]
  policy      CompanyPolicy?
  bookings    Booking[]

  @@index([status, createdAt])
  @@map("companies")
}

/// A person's role in their company; one company per person.
model CompanyMember {
  id        String      @id @default(uuid(7)) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  userId    String      @unique @map("user_id") @db.Uuid
  role      CompanyRole
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, role])
  @@map("company_members")
}

/// An emailed invitation to join a company: single use, stored as hashes.
model CompanyInvitation {
  id          String      @id @default(uuid(7)) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  /// HMAC (`company-invitation-email`) of the invited email, lower case.
  emailHash   String      @map("email_hash")
  /// The invited email with most of it hidden, for the admins' list ("fi***@acme.ng").
  emailHint   String      @map("email_hint")
  role        CompanyRole
  /// HMAC (`company-invitation`) of the emailed token.
  tokenHash   String      @unique @map("token_hash")
  invitedById String?     @map("invited_by_id") @db.Uuid
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?   @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([expiresAt])
  @@map("company_invitations")
}

/// A company's travel policy; a null field does not apply.
model CompanyPolicy {
  companyId            String       @id @map("company_id") @db.Uuid
  hotelNightlyCapMinor BigInt?      @map("hotel_nightly_cap_minor")
  hotelNightlyCurrency String?      @map("hotel_nightly_currency") @db.Char(3)
  maxCabin             CabinClass?  @map("max_cabin")
  minAdvanceDays       Int?         @map("min_advance_days")
  approvalMode         ApprovalMode @default(never) @map("approval_mode")
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_policies")
}

// ---------------------------------------------------------------------------
// Ads with consent (ADR-079)
// ---------------------------------------------------------------------------

enum AdConversionStatus {
  /// Kept at booking time; waits for the booking to be paid.
  waiting
  /// Every configured network accepted the Purchase event.
  sent
  /// Given up after AD_CONVERSION_MAX_ATTEMPTS sends.
  failed
  /// The visitor turned marketing off before it was sent: nothing goes out.
  withdrawn
}

/// The server-side Purchase event of a booking whose recorded cookie consent allowed marketing
/// when it was made. The click ids are cleared once sent or given up; retention purges the row.
model AdConversion {
  id            String             @id @default(uuid(7)) @db.Uuid
  bookingId     String             @unique @map("booking_id") @db.Uuid
  /// The cookie consent record (`cookie_consents.consent_id`) that allowed it.
  consentId     String             @map("consent_id") @db.Uuid
  /// { fbp?, fbc?, ttp?, ttclid? }: the networks' own identifiers; null once sent or given up.
  clickIds      Json?              @map("click_ids")
  status        AdConversionStatus @default(waiting)
  /// Networks that accepted the event, so a retry sends only to the others.
  sentTo        String[]           @default([]) @map("sent_to") @db.VarChar(16)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("ad_conversions")
}

// ---------------------------------------------------------------------------
// Support conversations (ADR-083)
// ---------------------------------------------------------------------------

enum SupportCategory {
  pre_booking
  booking_change
  cancellation_refund
  payment
  documents
  general
}

/// `open`: staff owe a reply; `waiting`: staff replied and wait for the traveller.
enum SupportStatus {
  open
  waiting
  resolved
}

enum SupportPriority {
  urgent
  prime
  normal
}

enum SupportChannel {
  web
  app
  whatsapp
}

/// `assistant`: the after-hours assistant (ADR-085), never a person.
enum SupportAuthor {
  customer
  staff
  system
  assistant
}

/// Text, a WhatsApp attachment that is recorded by type and never downloaded (ADR-084), or the
/// assistant's handover to people, which clients show in the traveller's language (ADR-085).
enum SupportMessageKind {
  text
  unsupported
  handover
}

/// Where a staff reply sent over WhatsApp stands; statuses only move forward (ADR-084).
enum SupportDeliveryStatus {
  pending
  sent
  delivered
  read
  failed
}

/// Someone who wrote to Suskii on WhatsApp (ADR-084). Never linked to an account automatically:
/// numbers are recycled. The phone and the business-scoped user id are sealed with
/// `whatsapp-contact:{id}:phone` / `:bsuid` and looked up by HMAC.
model WhatsAppContact {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// HMAC (`whatsapp-phone`) of the number's digits; null for a username user without one.
  phoneHash      String?   @unique @map("phone_hash")
  phoneEncrypted String?   @map("phone_encrypted")
  /// HMAC (`whatsapp-bsuid`) of the business-scoped user id, when Meta sends one.
  bsuidHash      String?   @unique @map("bsuid_hash")
  bsuidEncrypted String?   @map("bsuid_encrypted")
  /// Their last message: the 24-hour customer service window runs from here.
  lastInboundAt  DateTime  @map("last_inbound_at") @db.Timestamptz(3)
  /// They wrote STOP: no templates until they write again.
  optedOutAt     DateTime? @map("opted_out_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversations SupportConversation[]

  @@index([lastInboundAt])
  @@map("whatsapp_contacts")
}

/// A traveller's support conversation (the spec's support ticket). Owned by an account, or by a
/// guest who holds its access token; optionally about one booking. SLA times are in UTC.
model SupportConversation {
  id                    String          @id @default(uuid(7)) @db.Uuid
  /// Short code travellers can quote ("S-7KX2Q9").
  reference             String          @unique @db.VarChar(12)
  userId                String?         @map("user_id") @db.Uuid
  /// HMAC (`support-access`) of a guest's access token; null for account holders.
  accessTokenHash       String?         @unique @map("access_token_hash")
  /// A guest's email for reply notices, sealed with `support-conversation:{id}:email`.
  emailEncrypted        String?         @map("email_encrypted")
  bookingId             String?         @map("booking_id") @db.Uuid
  /// The WhatsApp contact for conversations on that channel (ADR-084).
  whatsappContactId     String?         @map("whatsapp_contact_id") @db.Uuid
  channel               SupportChannel
  category              SupportCategory
  priority              SupportPriority
  status                SupportStatus   @default(open)
  assigneeId            String?         @map("assignee_id") @db.Uuid
  /// Start of the current open spell: creation, or the traveller's message that reopened it.
  openedAt              DateTime        @map("opened_at") @db.Timestamptz(3)
  /// The traveller's first message staff have not answered yet; null while nothing is owed.
  replyOwedSince        DateTime?       @map("reply_owed_since") @db.Timestamptz(3)
  /// When staff owe the next reply (from `replyOwedSince` and the priority's target).
  responseDueAt         DateTime?       @map("response_due_at") @db.Timestamptz(3)
  /// When the conversation should be resolved (from `openedAt` and the priority's target).
  resolutionDueAt       DateTime?       @map("resolution_due_at") @db.Timestamptz(3)
  /// The nearer of the two while open or waiting; null once resolved. The inbox sorts by it.
  dueAt                 DateTime?       @map("due_at") @db.Timestamptz(3)
  firstRespondedAt      DateTime?       @map("first_responded_at") @db.Timestamptz(3)
  lastCustomerMessageAt DateTime        @map("last_customer_message_at") @db.Timestamptz(3)
  lastStaffMessageAt    DateTime?       @map("last_staff_message_at") @db.Timestamptz(3)
  /// The traveller last opened the conversation (unread staff replies come after this).
  customerReadAt        DateTime?       @map("customer_read_at") @db.Timestamptz(3)
  resolvedAt            DateTime?       @map("resolved_at") @db.Timestamptz(3)
  messageCount          Int             @default(0) @map("message_count")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User?            @relation("SupportOwner", fields: [userId], references: [id], onDelete: Cascade)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignee        User?            @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  whatsappContact WhatsAppContact? @relation(fields: [whatsappContactId], references: [id], onDelete: SetNull)
  messages        SupportMessage[]

  @@index([status, dueAt, id])
  @@index([userId, updatedAt])
  @@index([assigneeId, status])
  @@index([bookingId])
  @@index([status, updatedAt])
  @@index([whatsappContactId, updatedAt])
  @@map("support_conversations")
}

/// One message in a support conversation. Bodies are sealed per message
/// (`support-message:{id}:body`); `internal` notes are never shown to the traveller.
model SupportMessage {
  id               String                 @id @default(uuid(7)) @db.Uuid
  conversationId   String                 @map("conversation_id") @db.Uuid
  author           SupportAuthor
  /// The staff member who wrote it; null for travellers and system messages.
  staffId          String?                @map("staff_id") @db.Uuid
  internal         Boolean                @default(false)
  kind             SupportMessageKind     @default(text)
  bodyEncrypted    String                 @map("body_encrypted")
  /// WhatsApp's message id (`wamid`): inbound deliveries are deduplicated on it, and status
  /// webhooks find outbound replies by it.
  externalId       String?                @unique @map("external_id") @db.VarChar(255)
  /// Staff replies sent over WhatsApp only.
  deliveryStatus   SupportDeliveryStatus? @map("delivery_status")
  /// Why a reply was not delivered: a short code (`timeout`, `no-phone`, Meta's error code).
  deliveryError    String?                @map("delivery_error") @db.VarChar(64)
  /// Outside the 24-hour window the template notice went instead; the reply stays `pending` and
  /// is sent as text when the traveller writes back.
  noticeSentAt     DateTime?              @map("notice_sent_at") @db.Timestamptz(3)
  /// What an assistant answer rested on, for staff: FAQ ids with their questions, booking fact
  /// keys. Never personal data (ADR-085).
  assistantSources Json?                  @map("assistant_sources")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff        User?               @relation("SupportStaffAuthor", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([conversationId, id])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------------------------
// Status page (ADR-087): incidents staff write for travellers. Public text only: no personal
// data, and authors are in the audit log, not here.
// ---------------------------------------------------------------------------------------------

enum StatusIncidentImpact {
  minor
  major
}

enum StatusIncidentStage {
  investigating
  identified
  monitoring
  resolved
}

/// An incident on the public status page. `components` are `STATUS_COMPONENTS` values.
model StatusIncident {
  id         String               @id @default(uuid(7)) @db.Uuid
  title      String               @db.VarChar(120)
  impact     StatusIncidentImpact
  status     StatusIncidentStage
  components String[]
  startedAt  DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt DateTime?            @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  updates StatusIncidentUpdate[]

  @@index([resolvedAt, startedAt])
  @@map("status_incidents")
}

/// One public update on an incident: its stage at the time and what travellers should know.
model StatusIncidentUpdate {
  id         String              @id @default(uuid(7)) @db.Uuid
  incidentId String              @map("incident_id") @db.Uuid
  status     StatusIncidentStage
  message    String
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  incident StatusIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("status_incident_updates")
}

// --- Data rights requests and personal data breaches (ADR-089) ------------------------------

enum PrivacyRequestKind {
  access
  rectification
  erasure
  objection
  restriction
  portability
}

enum PrivacyRequestChannel {
  self_service
  email
  support
  phone
  post
}

enum PrivacyRequestStatus {
  open
  completed
  refused
}

enum PrivacyRefusalReason {
  identity_not_verified
  manifestly_unfounded
  legal_obligation
  no_data
}

enum PrivacyJurisdiction {
  NG
  KE
  ZA
  EU
  GB
  OTHER
}

enum PrivacyBreachStatus {
  open
  closed
}

enum BreachNoticeDecision {
  pending
  notified
  not_required
}

/// A data rights request and when the law wants it answered (`PRIVACY_RULES`). Self-service
/// exports and deletions are recorded closed; staff record the rest. The person is an account or
/// an email address to answer (encrypted with `privacy-request:{id}:email`).
model PrivacyRequest {
  id                     String                @id @default(uuid(7)) @db.Uuid
  kind                   PrivacyRequestKind
  jurisdiction           PrivacyJurisdiction
  channel                PrivacyRequestChannel
  status                 PrivacyRequestStatus  @default(open)
  userId                 String?               @map("user_id") @db.Uuid
  subjectEmailCiphertext String?               @map("subject_email_ciphertext")
  receivedAt             DateTime              @map("received_at") @db.Timestamptz(3)
  dueAt                  DateTime              @map("due_at") @db.Timestamptz(3)
  closedAt               DateTime?             @map("closed_at") @db.Timestamptz(3)
  refusalReason          PrivacyRefusalReason? @map("refusal_reason")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([userId])
  @@map("privacy_requests")
}

/// A personal data breach, from awareness to closing. `details` is encrypted
/// (`privacy-breach:{id}:details`); `categories` are `BREACH_DATA_CATEGORIES` values.
model PrivacyBreach {
  id                String              @id @default(uuid(7)) @db.Uuid
  title             String              @db.VarChar(120)
  detailsCiphertext String              @map("details_ciphertext")
  awareAt           DateTime            @map("aware_at") @db.Timestamptz(3)
  highRisk          Boolean             @map("high_risk")
  categories        String[]
  subjectsAffected  Int?                @map("subjects_affected")
  status            PrivacyBreachStatus @default(open)
  closedAt          DateTime?           @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  notices PrivacyBreachNotice[]

  @@index([status, awareAt])
  @@map("privacy_breaches")
}

/// What one regulator was told about a breach, and when it was due (`breachNoticeDueAt`).
model PrivacyBreachNotice {
  id                  String               @id @default(uuid(7)) @db.Uuid
  breachId            String               @map("breach_id") @db.Uuid
  jurisdiction        PrivacyJurisdiction
  regulatorDueAt      DateTime             @map("regulator_due_at") @db.Timestamptz(3)
  decision            BreachNoticeDecision @default(pending)
  regulatorNotifiedAt DateTime?            @map("regulator_notified_at") @db.Timestamptz(3)
  regulatorReference  String?              @map("regulator_reference") @db.VarChar(100)
  subjectsNotifiedAt  DateTime?            @map("subjects_notified_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  breach PrivacyBreach @relation(fields: [breachId], references: [id], onDelete: Cascade)

  @@unique([breachId, jurisdiction])
  @@index([decision, regulatorDueAt])
  @@map("privacy_breach_notices")
}
