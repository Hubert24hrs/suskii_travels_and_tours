{
  "name": "@suskii/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Suskii Travels mobile app (Expo Router, iOS and Android via EAS)",
  "license": "UNLICENSED",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "eas-build-post-install": "cd ../.. && pnpm exec turbo run build --filter=@suskii/mobile^...",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .expo .turbo",
    "test": "jest"
  },
