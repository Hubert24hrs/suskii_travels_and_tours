{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Suskii NestJS app (CommonJS output, decorators)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true,
    "types": ["node"]
  }
}
