{
  "name": "@suskii/ui-web",
  "version": "0.0.0",
  "private": true,
  "description": "Suskii web component library: accessible Radix-based components styled only with design tokens",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build:storybook": "storybook build --quiet --output-dir storybook-static",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:watch": "vitest",
    "clean": "rimraf storybook-static .turbo coverage"
  },
  "dependencies": {
    "@daypicker/react": "catalog:",
    "@suskii/design-tokens": "workspace:*",
    "@suskii/shared": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "catalog:",
    "@fontsource-variable/plus-jakarta-sans": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@suskii/config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "storybook": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  }
}
